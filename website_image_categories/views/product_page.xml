<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="product_product_variant_images_view">
        <field name="name">product.product.normal.view.website</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="product_variants_image_ids" mode="kanban"/>
            </xpath>
        </field>
    </record>


        <record id="product_template_attribute_value_view_form_inherited" model="ir.ui.view">
            <field name="name">product.template.attribute.value.view.form.inherited</field>
            <field name="model">product.template.attribute.value</field>
            <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='price_extra']" position="after">
                     <field name="image" invisible="display_type != 'color'"/>
                 </xpath>
            </field>
        </record>


