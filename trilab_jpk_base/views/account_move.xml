<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_trilab" model="ir.ui.view">
    <field name="name">account.move.form.trilab</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <!-- Invoice Lines -->
        <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
            <field name="x_pl_vat_gtu"
                   string="GTU"
                   column_invisible="parent.move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
        </xpath>

        <!-- Journal Items -->
        <xpath expr="//field[@name='line_ids']/list/field[@name='tax_ids']" position="before">
            <field name="x_pl_vat_gtu"
                   string="GTU"
                   column_invisible="parent.move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
        </xpath>

        <!-- Notebook Page -->
        <notebook position="inside">
            <page id="pl_extra"
                  string="PL Extra"
                  invisible="move_type == 'entry' or country_code != 'PL'">

                <!-- Customer Invoices -->
                <group invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <field name="pl_vat_date"/>
                        <field name="x_pl_vat_mpp"/>
                        <field name="x_pl_vat_reverse_charge"/>
                        <field name="x_pl_vat_typ_dokumentu"/>
                        <field name="x_pl_vat_sw"/>
                        <field name="x_pl_vat_ee"/>
                    </group>

                    <group>
                        <field name="x_pl_vat_tp"/>
                        <field name="x_pl_vat_tt_d"/>
                        <field name="x_pl_vat_mr_t"/>
                    </group>

                    <group>
                        <field name="x_pl_vat_mr_uz"/>
                        <field name="x_pl_vat_i42"/>
                        <field name="x_pl_vat_i63"/>
                        <field name="x_pl_vat_b_spv"/>
                    </group>

                    <group>
                        <field name="x_pl_vat_b_spv_dostawa"/>
                        <field name="x_pl_vat_b_mpv_prowizja"/>
                        <field name="x_pl_vat_korekta_podstawy_opodt"/>
                    </group>

                    <group>
                        <field name="x_pl_vat_wsto_ee"/>
                        <field name="x_pl_vat_ied"/>
                    </group>
                </group>

                <!-- Shared Field -->
                <group>
                    <group>
                        <field name="x_pl_change_jpk_proof"/>
                    </group>
                </group>

                <!-- Vendor Bills -->
                <group invisible="move_type not in ('in_invoice', 'in_refund')">
                    <group>
                        <field name="pl_vat_date"/>
                        <field name="x_pl_vat_mpp"/>
                        <field name="x_pl_vat_dokument_zakupu"/>
                        <field name="x_pl_vat_imp"/>
                        <field name="x_pl_vat_korekta_podstawy_opodt"/>
                    </group>

                    <group>
                        <field name="x_pl_vat_tp"/>
                        <field name="x_pl_vat_tt_wnt"/>
                    </group>
                </group>

            </page>
        </notebook>

    </field>
</record>
</odoo>
