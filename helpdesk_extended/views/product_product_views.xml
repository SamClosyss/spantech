<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_product_view_form_extended" model="ir.ui.view">
        <field name="name">product.product.view.form.extended</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_tickets" type="object" icon="fa-ticket">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="ticket_count" widget="statinfo" nolabel="1" class="mr4"/>
                        </span>
                        <span class="o_stat_text">Tickets</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
