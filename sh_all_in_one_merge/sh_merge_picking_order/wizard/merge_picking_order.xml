<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_merge_picking_order_wizard_form" model="ir.ui.view">
        <field name="name">sh.merge.picking.order.wizard</field>
        <field name="model">sh.merge.picking.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Picking Orders">
                <group>
                    <field name="merge_type" widget="radio" />
                </group>
                <group>
                    <group>
                        <field name="picking_type_code" invisible="1" />
                        <field name="picking_order_ids" widget="many2many_tags" invisible="1" />
                        <field name="picking_order_id" domain="[('state','in',['draft','waiting','confirmed','assigned']),('id','not in',picking_order_ids)]" invisible="merge_type in ['nothing_new','cancel_new','remove_new']" required="merge_type in ['nothing_existing','cancel_existing','remove_existing']" />
                        <field name="partner_id" invisible="picking_order_id or merge_type in ['nothing_existing','cancel_existing','remove_existing']" required="not picking_order_id" />
                        <field name="location_id" invisible="picking_order_id or picking_type_code == 'incoming' or merge_type in ['nothing_existing','cancel_existing','remove_existing']" required="not picking_order_id" />
                        <field name="location_dest_id" invisible="picking_order_id or picking_type_code == 'outgoing' or merge_type in ['nothing_existing','cancel_existing','remove_existing']" required="not picking_order_id" />
                    </group>
                </group>
                <notebook>
                    <page string="Merge Lines" name="merge_line_ids">
                        <field name="merge_line_ids" mode="list">
                            <list editable="bottom" create="false" delete="false">
                                <field name="picking_order_id" required="1" readonly="1" force_save="1" />
                                <field name="product_id" readonly="1" force_save="1" required="1" />
                                <field name="qty" required="1" />
                                <field name="qty_available" readonly="1" />
                                <field name="picking_order_line_id" invisible="1" />
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button class="btn-primary" name="action_merge_picking_order" type="object" string="Merge" />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sh_merge_picking_order_multi_action" model="ir.actions.act_window">
        <field name="name">Merge Picking Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.merge.picking.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sh_merge_picking_order_wizard_form" />
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_view_types">list</field>
        <field name="target">new</field>
    </record>
</odoo>
