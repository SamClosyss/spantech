<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sh_website_res_config_settings_product_category_inherit" model="ir.ui.view">
        <field name="name">website.res.config.settings.product.category</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Merge Internal Category to Ecommerce Category" id="sh_ecommerce_categories_merge_config">
                    <setting help="Sync new Internal Category to Ecommerce Category">
                        <field name="sync_with_ecommerce_category" />
                    </setting>
                    <setting help="Auto Sync new product to Ecommerce Category">
                        <field name="auto_sync_product_with_ecommerce_category" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
