<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_mrp_config_setting_view" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Manufacturing Order Merge Configuration" id="sh_merge_mrp_order_config">
                    <setting help="Select merge type">
                        <field name="merge_type" widget="radio" />
                    </setting>
                    <setting help="Merge MRP Quantity">
                        <field name="sh_mrp_sub_merge_qty" />
                    </setting>
                    <setting help="Notify in chatter">
                        <field name="notify_in_chatter" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
