<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sh_pos_res_config_settings_product_category_inherit" model="ir.ui.view">
        <field name="name">pos.res.config.settings.product.category</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Merge Internal Category to POS Category" id="sh_pos_categories_merge_config">
                    <setting help="Sync new Internal Category to POS Category">
                        <field name="sync_with_pos_category" />
                    </setting>
                    <setting help="Auto Sync new product to POS Category">
                        <field name="auto_sync_product_with_pos_category" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
