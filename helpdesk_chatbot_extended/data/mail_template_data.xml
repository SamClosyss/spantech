<?xml version="1.0"?>
<odoo>
    <record id="email_template_chatbot" model="mail.template">
        <field name="model_id" ref="im_livechat.model_chatbot_script_step"/>
        <field name="name">ChatBot Extend</field>
        <field name="subject">ChatBot</field>
        <field name="email_from">{{ user.email_formatted }}
        </field>
        <field name="email_to">{{ (object.email) }}</field>
<!--        <field name="lang">{{ object.lang }}</field>-->
        <field name="body_html" type="html">
            <p>Please Find chat conversion as Below</p>
            <t t-if="ctx.get('description')">
                <t t-esc="ctx.get('description')" />
            </t>
        </field>
    </record>
</odoo>
