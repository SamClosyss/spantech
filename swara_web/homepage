    <!-- Hero Section Start -->
	<section class="hero-section">
		<div class="hero__inner">
			<h2 class="title">Little Swara Shop</h2>
			<div class="subtitle">
				<p>bringing safari charm to your life</p>
			</div>
      </div>
	</section>
	<!-- Hero Section End -->

	<!-- Living Section Start -->
	<section class="living-section container">
		<div class="row living-inner">
			<div class="col-md-6">
				<img src="/swara_web/static/src/images/living-bg.jpg" class="img img-fluid" />
			</div>
			<div class="col-md-6 living-content">
				<h2 class="title">Living a safari life</h2>
				<div class="subtitle">
					<p>Bring the warmth of an African setting to your home and live a safari life every day. Karibu!</p>
				</div>
			</div>
		</div>		
	</section>
	<!-- Living Section End -->

	<!-- Feature Section Start -->
	<section class="feature-section container">
		<div class="section-header">
			<h2 class="text-center">Out of Kenya</h2>
		</div>

			<div class="row">
				<div class="col-md-4 feature-card">
					<img src="/swara_web/static/src/images/feature1.jpg" class="img img-responsive" />
					<h3 class="title">From the land of Maasai</h3>
					<div class="description">
						<p>
							There are 42 tribes in Kenya, however just several have been widely known due to nature programs and movies. We have paired with artisans from many different tribes to combine their ancient artworks with modern day life. Let's enrich our lives with color, texture&amp;nbsp;and&amp;nbsp;the famous safari charm.&amp;nbsp;
						</p>
					</div>
				</div>
				<div class="col-md-4 feature-card">
					<img src="/swara_web/static/src/images/feature2.jpg" class="img img-responsive" />
					<h3 class="title">From the land of Maasai</h3>
					<div class="description">
						<p>
							Our workshop is nested within a wildlife sanctuary in Kenya. We are inspired by over 3000 wild animals roaming freely around us, hence we liberally use animal print throughout our handmade accessories.  From timeless zebra to painted cotton fabrics, we bring wild nature to your home. 
						</p>
					</div>
				</div>
				<div class="col-md-4 feature-card">
					<img src="/swara_web/static/src/images/feature3.jpg" class="img img-responsive" />
					<h3 class="title">From the land of Maasai</h3>
					<div class="description">
						<p>
							Our artisans are often single supporters of large families, handmaking our safari accessories often with very basic tools and old machinery. Some of our paintings are made by impoverished artists, talented youngsters whose school fees are paid by proceeds from their artwork. By purchasing our products you are directly contributing toward wellbeing of a large number of people and families in Kenya.
						</p>
					</div>
				</div>
			</div>
	</section>
	<!-- Feature Section End -->


