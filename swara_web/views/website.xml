<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_view_form" model="ir.ui.view">
        <field name="name">website_view_from</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Home page collection">
                    <group string="First Collection" name="collect_1">
                        <field name="collection_1_name"/>
                        <field name="collection_1_image"/>
                        <field name="collection_1_url"/>
                    </group>

                    <group string="Second Collection" name="collect_2">
                        <field name="collection_2_name"/>
                        <field name="collection_2_image"/>
                        <field name="collection_2_url"/>
                    </group>

                    <group string="Third Collection" name="collect_3">
                        <field name="collection_3_name"/>
                        <field name="collection_3_image"/>
                        <field name="collection_3_url"/>
                    </group>
                </page>

                <page string="Home page Products">
                    <field name="home_product_ids">
                        <tree string="Products">
                            <field name="type" />
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="default_code"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>