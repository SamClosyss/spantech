<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="swara_collections_form" model="ir.ui.view">
        <field name="name">swara.collections.form</field>
        <field name="model">swara.collections</field>
        <field name="arch" type="xml">
            <form string="Collections">
                <sheet>
                    <field name="image" widget="image" class="oe_avata"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>

                    <field name="description" widget="html" options="{'style-inline': true, 'codeview': true }"/>
                    <field name="product_ids">
                        <tree string="Products">
                            <field name="type"/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="default_code"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="swara_collections_tree" model="ir.ui.view">
        <field name="name">swara.collections.tree</field>
        <field name="model">swara.collections</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_swara_collections" model="ir.actions.act_window">
        <field name="name">Swara collections</field>
        <field name="res_model">swara.collections</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>

    <menuitem action="action_swara_collections"
              id="collection_menu"
              parent="website_sale.menu_ecommerce"
    />
</odoo>
