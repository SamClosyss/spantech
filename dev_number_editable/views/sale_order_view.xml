<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="sale_order_edit_name" model="ir.ui.view">
	 <field name="name">sale.order.hide.other.info</field>
	 <field name="model">sale.order</field>
	 <field name="inherit_id" ref="sale.view_order_form"/>
	 <field name="arch" type="xml">
	    <xpath expr="//field[@name='name']" position="replace">
	            <field name="name" readonly="cop_name == False or state in ['draft','cancel']"/>
	            <field name="cop_name" invisible="1"  />
	    </xpath>
	    
	</field>
 </record>
</odoo>






