<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="purchase_order_edit_name" model="ir.ui.view">
	 <field name="name">purchase.order.edit.name</field>
	 <field name="model">purchase.order</field>
	 <field name="inherit_id" ref="purchase.purchase_order_form"/>
	 <field name="arch" type="xml">
	    <xpath expr="//field[@name='name']" position="replace">
	            <field name="name" attrs="{'readonly': ['|', ('cop_name' , '=', False), ('state', 'in', ('draft','cancel'))]}"/>
	            <field name="cop_name" invisible="1"  />
	    </xpath>
	    
	    
	</field>
 </record>
</odoo>






