                              <span><svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-quote" viewBox="0 0 41 35"><path d="M10.208 17.711h6.124v16.332H0V21.684C0 8.184 5.444.956 16.332 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766zm24.498 0h6.124v16.332H24.498V21.684C24.498 8.184 29.942.956 40.83 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766z" fill="#000" fill-rule="evenodd"></path></svg></span>
                              <p>Life is like a shadow and a mist; it passes quickly by, and is no more. </p>
                              <small>- African proverb</small>
                          </div>
                      </div>
                  </div> -->
              </div>
          </div>
          <!-- review section end -->

          <!-- items section start -->
          <div class="item-wrapper oe_structure oe_empty">
              <div class="container-fluid">
                  <div class="row">
                      <div class="col-lg-4 col-md-4 col-sm-12 col-12 px-0">
                          <a class="item-box" href="javascript:;">
                              <img src="/swara_shop_kenya/static/src/images/items1.webp" alt="" class="w-100"/>
                              <span>Tribal jewellery</span>
                          </a>
                      </div>
                      <div class="col-lg-4 col-md-4 col-sm-12 col-12 px-0">
                          <a class="item-box" href="javascript:;">
                              <img src="/swara_shop_kenya/static/src/images/items2.webp" alt="" class="w-100"/>
                              <span>Maasai shoes</span>
                          </a>
                      </div>
                      <div class="col-lg-4 col-md-4 col-sm-12 col-12 px-0">
                          <a class="item-box" href="javascript:;">
                              <img src="/swara_shop_kenya/static/src/images/items3.webp" alt="" class="w-100"/>
                              <span>Safari style</span>
                          </a>
                      </div>
                  </div>
              </div>
          </div>
          </div>
        </xpath>
    </template>
</odoo>

