<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="trilab_pl_DFD" model="account.report">
        <field name="name">PL Detailed Financial Data DFD</field>
        <field name="filter_date_range" eval="False"/>
        <field name="filter_analytic" eval="True"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">today</field>
        <field name="column_ids">
            <record id="trilab_pl_DFD_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="trilab_pl_DFD_A" model="account.report.line">
                <field name="name">Inne przychody finansowe, w tym:</field>
                <field name="code">DFD_A</field>
                <field name="hierarchy_level" eval="1"/>
                <field name="aggregation_formula">DFD_A_1.balance + DFD_A_2.balance</field>
                <field name="children_ids">
                    <record id="trilab_pl_DFD_A_1" model="account.report.line">
                        <field name="name">- zysk z różnic kursowych</field>
                        <field name="code">DFD_A_1</field>
                        <field name="hierarchy_level" eval="2"/>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="trilab_pl_DFD_A_1_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.tag_ids','=', ref('trilab_pl_reports.DFD_A_1'))]"/>
                                <field name="subformula">(abs(sum)-(sum))/2</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                    <record id="trilab_pl_DFD_A_2" model="account.report.line">
                        <field name="name">- inne pozostałe przychody finansowe</field>
                        <field name="code">DFD_A_2</field>
                        <field name="hierarchy_level" eval="2"/>
                        <field name="domain_formula">-sum([('account_id.tag_ids','=', ref('trilab_pl_reports.DFD_A_2'))])</field>
                        <field name="foldable" eval="True"/>
                    </record>
                </field>
            </record>
            <record id="trilab_pl_DFD_B" model="account.report.line">
                <field name="name">Inne koszty finansowe, w tym:</field>
                <field name="code">DFD_B</field>
                <field name="hierarchy_level" eval="1"/>
                <field name="aggregation_formula">DFD_B_1.balance + DFD_B_2.balance</field>
                <field name="children_ids">
                    <record id="trilab_pl_DFD_B_1" model="account.report.line">
                        <field name="name">- strata z różnic kursowych</field>
                        <field name="code">DFD_B_1</field>
                        <field name="hierarchy_level" eval="2"/>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="trilab_pl_DFD_B_1_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.tag_ids','=', ref('trilab_pl_reports.DFD_B_1'))]"/>
                                <field name="subformula">(abs(sum)+(sum))/2</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                    <record id="trilab_pl_DFD_B_2" model="account.report.line">
                        <field name="name">- inne pozostałe koszty finansowe</field>
                        <field name="code">DFD_B_2</field>
                        <field name="hierarchy_level" eval="2"/>
                        <field name="domain_formula">sum([('account_id.tag_ids','=', ref('trilab_pl_reports.DFD_B_2'))])</field>
                        <field name="foldable" eval="True"/>
                    </record>
                </field>
            </record>
        </field>
    </record>

</odoo>
