<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="view_out_invoice_tree_extended_sp" model="ir.ui.view">
            <field name="name">account.move.tree.extended_sp</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="state" position="after">
                    <field name="invoice_confirmation_sent"
                           widget="badge"
                           optional="show"
                           decoration-danger="invoice_confirmation_sent == 'no'"
                           decoration-success="invoice_confirmation_sent == 'yes'"/>
                </field>
                <field name="name" position="after">
                    <field name="note"/>
                </field>
            </field>
        </record>

        <record id="account_view_move_form_inherited_extended_sp" model="ir.ui.view">
            <field name="name">account.view.move.form.inherited.extended.sp</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                    <attribute name="string">Description</attribute>
                </xpath>
                <xpath expr="//group[@name='sale_info_group']/field[@name='partner_bank_id']" position="after">
                    <field name="note" placeholder="Comment..."/>
                    <!--<group name="note_group" col="6" class="mt-2 mt-md-0">-->
                    <!--<group colspan="4">-->
                    <!--<field name="note" nolabel="1" placeholder="Comments..."/>-->
                    <!--</group>-->
                    <!--<div class="oe_clear"/>-->
                    <!--</group>-->
                </xpath>

                <!-- https://spantech.odoo.com/web?debug=1#id=391&menu_id=554&cids=7%2C4%2C3%2C2%2C1&action=806&model=project.task&view_type=form -->
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create': True}</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
