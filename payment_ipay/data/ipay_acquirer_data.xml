<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="payment_provider_ipay" model="payment.provider">
            <field name="name">iPay Payment Gateway</field>
            <field name="image_128" type="base64" file="payment_ipay/static/description/icon.png"/>
            <field name="redirect_form_view_id" ref="payment_ipay.redirect_form"/>
            <field name="code">ipayafrica</field>
            <field name="ipay_currency_id" ref="base.KES"/>
            <field name="module_id" ref="base.module_payment_ipay"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="state">test</field>
            <field name="pre_msg"><![CDATA[
            <p>You will be redirected to iPay checkout page for payment.</p>]]></field>

    </record>
    <record id="payment_method_ipayafrica" model="account.payment.method">
        <field name="name">iPay Africa</field>
        <field name="code">ipayafrica</field>
        <field name="payment_type">inbound</field>
    </record> 

</data>
</odoo>
