<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- studio_customization.odoo_studio_res_part_cc2dd356-e18b-4bdd-887d-c759e472fbdb -->
    <record id="view_partner_form_extend_x_studio" model="ir.ui.view">
        <field name="name">res.partner.form.extend.x_studio</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="x_studio_erpag_account_number" string="Internal account number"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="x_studio_contact_name" string="Contact name"/>
                <field name="x_studio_contact_telephone_number" string="contact telephone number"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="x_studio_many2one_field_5MK2F"/>
            </xpath>
            <!-- https://spantech.odoo.com/web?debug=1#menu_id=554&cids=7%2C4%2C3%2C2%2C1%2C6%2C8%2C5%2C10%2C9&id=1001&action=806&model=project.task&view_type=form -->
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="string">Contact Tags</attribute>
            </xpath>

            <!-- https://spantech.odoo.com/web?debug=1#menu_id=554&cids=7%2C4%2C3%2C2%2C1%2C6%2C8%2C5%2C10%2C9&id=1027&action=806&model=project.task&view_type=form -->
            <xpath expr="//notebook" position="inside">
                <page name="mml_products" string="Related MML Products" invisible="company_id != 3">
                    <!--<field name="mml_product_info_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>-->
                    <field name="mml_product_info_ids" mode="list">
                        <list string="Linked Contacts" create="0" edit="0">
                            <field name="name"/>
                            <field name="mml_owner"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- studio_customization.odoo_studio_res_part_4803ab03-e8db-4638-a68a-ae1ee7a8cde9 -->
    <record id="res_partner_view_tree_inherit_x_studio" model="ir.ui.view">
        <field name="name">res.partner.view.tree.inherit.x_studio</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="before">
                <field name="x_studio_erpag_account_number" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="lang" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='phone']" position="after">
                <field optional="show" name="x_studio_many2one_field_5MK2F"/>
            </xpath>
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="property_product_pricelist" optional="show"/>
                <field name="property_supplier_payment_term_id" optional="show"/>
                <field name="property_payment_term_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>