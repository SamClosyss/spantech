<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="account_view_move_form_inherited_extended" model="ir.ui.view">
            <field name="name">account.view.move.form.inherited.extended</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                    <field name="product_tmpl_notes"/>
                    <field name="product_tmpl_hs_code"/>
                    <field name="product_tmpl_country_of_origin"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>