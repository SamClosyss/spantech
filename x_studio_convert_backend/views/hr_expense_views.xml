<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- studio_customization.odoo_studio_hr_expen_871c8230-8ee4-4670-a37b-1508545d7065 -->
    <record id="hr_expense_view_form_x_studio" model="ir.ui.view">
        <field name="name">hr.expense.form.inherit.x_studio</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="x_studio_expense_relating_to_r_d" string="R &amp; D Expense"/>
            </xpath>
        </field>
    </record>

    <!-- studio_customization.odoo_studio_hr_expen_bd50740c-ff5b-4c35-bb81-6f441190c97d -->
    <record id="view_expenses_tree_x_studio" model="ir.ui.view">
        <field name="name">hr.expense.tree.inherit.x_studio</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.view_expenses_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list[1]/field[@name='name']" position="after">
                <field name="message_attachment_count" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
