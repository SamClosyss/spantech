<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Product Additional Notes to PO report -->
    <template id="report_purchaseorder_document_extended_spantech" inherit_id="purchase.report_purchaseorder_document">++
        <xpath expr="//span[@t-field='line.name']" position="replace">
                <span class="py-2" t-field="line.product_id.default_code"
                      t-options="{'widget': 'text'}"/>
                <br/>
                <p class="bold_font">
                    <t t-esc="line.name"/>
                    <t t-if="line.product_tmpl_notes">
                        <br/>
                        <t t-esc="line.product_tmpl_notes"/>
                    </t>
                </p>
                <span class="pb-1" t-field="line.product_id.x_studio_additional_description"
                      t-options="{'widget': 'text'}"/>
                <br/>
                <span t-field="line.product_tmpl_hs_code"
                      t-options="{'widget': 'text'}"/>
                Country of Origin:
                <span t-field="line.product_tmpl_country_of_origin"
                      t-options="{'widget': 'text'}"/>
        </xpath>
        <xpath expr="//td[@id='section']" position="replace">
            <td colspan="99" id="section">
                <span class="py-2" t-field="line.product_id.default_code"
                      t-options="{'widget': 'text'}"/>
                <br/>
                <p class="bold_font">
                    <t t-esc="line.name"/>
                    <t t-if="line.product_tmpl_notes">
                        <br/>
                        <t t-esc="line.product_tmpl_notes"/>
                    </t>
                </p>
                <span class="pb-1" t-field="line.product_id.x_studio_additional_description"
                      t-options="{'widget': 'text'}"/>
                <br/>
                <span t-field="line.product_tmpl_hs_code"
                      t-options="{'widget': 'text'}"/>
                Country of Origin:
                <span t-field="line.product_tmpl_country_of_origin"
                      t-options="{'widget': 'text'}"/>
            </td>
        </xpath>
    </template>

