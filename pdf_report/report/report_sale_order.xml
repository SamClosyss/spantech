<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="saleorder_document">
        <t t-call="pdf_report.spantech_layout_standard">
            <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page sale-receipt">
                <div class="oe_structure"/>

                <table class="table table-sm o_main_table address_table" name="invoice_line_table">
                    <thead>
                        <tr class="bg-lightgrey">
                            <th class="text-left">
                                <span class="text-bold">Invoice to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">Ship to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">Reference No:</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="address_tbody">
                        <tr>
                            <td class="text-left">
                                <t t-if="o.partner_invoice_id">
                                    <h6 t-field="o.partner_invoice_id.name"/>
                                    <p>
                                        <span t-if="o.partner_invoice_id.street">
                                            <t t-esc="o.partner_id.street"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.street2">
                                            <t t-esc="o.partner_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.city">
                                            <t t-esc="o.partner_id.city"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.zip">
                                            <t t-esc="o.partner_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.country_id">
                                            <t t-esc="o.partner_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="o.partner_shipping_id">
                                    <h6 t-field="o.partner_shipping_id.name"/>
                                    <p>
                                        <span t-if="o.partner_shipping_id.street">
                                            <t t-esc="o.partner_shipping_id.street"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.street2">
                                            <t t-esc="o.partner_shipping_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.city">
                                            <t t-esc="o.partner_shipping_id.city"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.zip">
                                            <t t-esc="o.partner_shipping_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.country_id">
                                            <t t-esc="o.partner_shipping_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="is_pro_forma">
                                    <span t-field="o.proforma_invoice_number"/>
                                </t>
                                <t t-elif="o.name">
                                    <span t-field="o.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Attn:</h6>
                                <t t-if="o.partner_contact_id">
                                    <span t-field="o.partner_contact_id.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Shipping:</h6>
                                <t t-if="o._name == 'sale.order'">
                                    <span t-field="o.shipping_info"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Date:</h6>
                                <t t-if="o.date_order">
                                    <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Customers Purchase Order Number:</h6>
                                <t t-if="o.client_order_ref">
                                    <span t-field="o.client_order_ref"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <!--<td class="text-left">-->
                            <!--<h6>Incoterms</h6>-->
                            <!--<t t-if="o.incoterm">-->
                            <!--<span t-field="o.incoterm"/>-->
                            <!--</t>-->
                            <!--<t t-else="">-->
                            <!--<span>-</span>-->
                            <!--</t>-->
                            <!--</td>-->
                            <td t-if="o.company_id.id == 1" class="text-left">
                                <h6>Incoterm:</h6>
                                <t t-if="o.incoterm">
                                    <span t-field="o.incoterm"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td t-else="" class="text-left">
                                <h6>Incoterm:</h6>
                                <t t-if="o.wo_incoterm">
                                    <span t-field="o.wo_incoterm"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Payment terms:</h6>
                                <span><t t-esc="o.payment_term_id.name or '-'"/></span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Customers RFQ:</h6>
                                <t t-if="o.client_order_rfq">
                                    <span t-field="o.client_order_rfq"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td t-if="o.company_id.report_format == 'spantech_report'" class="text-left">
                                <t t-if="env.context.get('confirmation', False) or is_order_conformation">
                                    <h6>Est. Delivery:</h6>
                                </t>
                                <t t-else="">
                                    <h6>Quote Expiry:</h6>
                                </t>
                                <t t-if="env.context.get('confirmation', False) or is_order_conformation">
                                    <span t-field="o.commitment_date"
                                          t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <span t-field="o.validity_date"
                                          t-options='{"widget": "date"}'/>
                                </t>
                            </td>
                            <td t-else="" class="text-left">
                                <t t-if="env.context.get('confirmation', False) or is_order_conformation">
                                    <h6>Due Date:</h6>
                                </t>
                                <t t-else="">
                                    <h6>Quote Expiry:</h6>
                                </t>
                                <t t-if="o.validity_date">
                                    <span t-field="o.validity_date"
                                          t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Lead Time:</h6>
                                <t t-if="o.lead_time_sp">
                                    <span t-field="o.lead_time_sp"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>


                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>

                <table class="table table-sm o_main_table product_table">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr class="bg-lightgrey">
                            <th name="th_index" class="text-left">
                                <span>No.</span>
                            </th>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_quantity" class="text-right">Quantity</th>
                            <th name="th_priceunit" class="text-right">Price</th>
                            <th name="th_discount" t-if="display_discount" class="text-right"
                                groups="product.group_discount_per_so_line">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_taxes" class="text-right">Tax %</th>
                            <th name="th_subtotal" class="text-right">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <t t-set="index" t-value="1"/>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="doc.order_line" t-as="line">

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                               groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                               groups="account.group_show_line_subtotals_tax_included"/>

                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td class="text-right" name="product_index" style="vertical-align: middle;">
                                        <span t-esc="index"/>
                                    </td>
                                    <td name="td_name">
                                        <span class="py-2" t-field="line.product_id.default_code"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <p class="bold_font">
                                            <t t-esc="line.name"/>
                                            <t t-if="line.product_tmpl_notes">
                                                <br/>
                                                <t t-esc="line.product_tmpl_notes"/>
                                            </t>
                                        </p>
                                        <span class="pb-1" t-field="line.product_id.x_studio_additional_description"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <span t-field="line.product_tmpl_hs_code"
                                              t-options="{'widget': 'text'}"/>
                                        Country of Origin:
                                        <span t-field="line.product_tmpl_country_of_origin"
                                              t-options="{'widget': 'text'}"/>
                                        <span t-if="line.product_id.contract_number">
                                            <br/>
                                            Contract Number:
                                            <span t-field="line.product_id.contract_number"
                                                  t-options="{'widget': 'text'}"/>
                                        </span>
                                    </td>
                                    <td name="td_quantity" class="text-right">
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <td name="td_priceunit" class="text-right">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" class="text-right"
                                        groups="product.group_discount_per_so_line">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <td name="td_taxes" class="text-right">
                                        <span t-esc="', '.join(map(lambda x: str(x.amount)+'%', line.tax_id))"/>
                                    </td>
                                    <td name="td_subtotal" class="text-right o_price_total">
                                        <span t-field="line.price_subtotal"
                                              groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span t-field="line.price_total"
                                              groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td name="td_section_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td name="td_note_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                            </tr>

                            <t t-set="index" t-value="index + 1"/>

                            <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-right">
                                    <td name="td_section_subtotal" colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                                t-esc="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row border-dark border mx-0" style="border-width: 2px !important;"
                         name="total">
                        <div class="col-7">
                            <p class="payment_details py-2">
                                <span class="font_bold">
                                    <u>Payment details</u>
                                </span>
                                <br/>
                                <!-- Spantech Products Ltd -->
                                <t t-if="o.company_id.report_format in ['spantech_report', 'mjs_report']">
                                    <span>Spantech Products Ltd * Account No. 00478914</span>
                                    <br/>
                                    <span>Bank address: Lloyds Bank plc, Langham Place Branch</span>
                                    <br/>
                                    <span>PO Box 1000, London BX1 1LT, United Kingdom</span>
                                    <br/>
                                    <span>Sort Code 30 93 68 « Swift: LOYDGB21028</span>
                                    <br/>
                                    <span>IBAN GB28LOYD30936800478914</span>
                                </t>
                                <!-- Spancan n Equipment Ltd -->
                                <t t-elif="o.company_id.report_format == 'spancan_n_equipment_report'">
                                    <span><b>PUNJAB NATIONAL BANK</b></span>
                                    <br/>
                                    <span>Bank Account: 0720050106561</span>
                                    <br/>
                                    <span>Beneficiary Name: Spancan N Equipment</span>
                                    <br/>
                                    <span>MICR Code: 700024281</span>
                                    <br/>
                                    <span>Branch Code : 072020</span>
                                    <br/>
                                    <span>IFSC Code: PUNB0072020</span>
                                    <br/>
                                    <span>Branch AD Code: 03002OH</span>
                                    <br/>
                                    <span>Bank Swift Code: PUNBINBBISB</span>
                                </t>
                            </p>
                        </div>
                        <div class="col-5 p-0 align-self-stretch d-flex">
                            <table class="table table-sm border border-dark total_table"
                                   style="page-break-inside: avoid;color: black;font-weight: bold;">
                                <!-- Tax totals -->
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>
                            </table>
                        </div>
                    </div>
                </div>

                <br/>
                <!-- https://spantech.odoo.com/web#id=480&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
                <p t-if="o.is_IGM_customer" class="terms mt-1">
                    <span class="font_bold" style="font-size:20px">
                        <u>For IGM Declaration</u>
                    </span>
                    <br/>
                    <table name="IFM_Info" class="table table-sm o_main_table address_table" style="width:70%;">
                        <tbody>
                            <tr>
                                <td class="text-center" style="width:20%;">Consignee Name</td>
                                <td class="text-center">
                                    <span t-field="o.consignee_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Notify Party</td>
                                <td class="text-center">
                                    <span t-field="o.notify_party"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Value For Customs with Currency</td>
                                <td class="text-center">
                                    <span t-field="o.value_for_customs_with_currency"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Gross Weight</td>
                                <td class="text-center">
                                    <span t-field="o.manifested_gross_weight"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Packages</td>
                                <td class="text-center">
                                    <span t-field="o.manifested_packages"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Descrition of Goods</td>
                                <td class="text-center">
                                    <span t-field="o.description_of_goods"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </p>

                <br/>
                <t t-if="o.company_id.report_format == 'mjs_report'">
                    <span class="font_bold">
                        <strong><u>Payment Details</u></strong>
                    </span>
                    <!-- Payment Communication -->
                    <div style="margin-top:15px;">
                        <p>
                            <strong>
                                Please use the following communication for your payment:
                                <t t-esc="o.name"/>
                            </strong>
                        </p>
                    </div>
                
                    <!-- Bank Details -->
                    <div style="margin-top:10px;">
                        <p><strong>Advance Payment required in <strong>GBP Currency</strong> to:</strong></p>
                        <ul style="list-style-type: disc; padding-left:18px; margin:0;">
                            <li>Revolut Ltd, 30 South Colonnade, E14 5HX, London, United Kingdom</li>
                            <li><strong>Account Number:</strong> 25698812</li>
                            <li><strong>Account Name:</strong> MJS PURGE SYSTEMS LIMITED</li>
                            <li><strong>Sort Code:</strong> 23-01-20</li>
                            <li><strong>SWIFT:</strong> REVOGB21</li>
                            <li><strong>IBAN:</strong> GB32REVO00996942301378</li>
                        </ul>
                    </div>
                    <!-- Electronic Payments -->
                    <div style="margin-top:15px;">
                        <p><strong>Electronic Payments</strong></p>
                        <ul style="list-style-type: disc; padding-left:18px; margin:0;">
                            <li>
                                Electronic payments can be made from your bank, credit card, or Google Pay using the link below:
                            </li>
                            <li>
                                <a href="https://checkout.revolut.com/pay/928e8669-ec4b-46a1-a985-ffe205a2720d" target="_blank">
                                    https://checkout.revolut.com/pay/928e8669-ec4b-46a1-a985-ffe205a2720d
                                </a>
                            </li>
                        </ul>
                    </div>
                
                    <!-- Usage Instructions -->
                    <div style="margin-top:10px; margin-bottom:32px;">
                        <p><strong>Usage Instructions</strong></p>
                        <ul style="list-style-type: disc; padding-left:18px; margin:0;">
                            <li>Click on the link above</li>
                            <li>Insert the amount you wish to pay in the “Amount” box</li>
                            <li>Write in the “Note” box:
                                <ul style="list-style-type: circle; padding-left:18px;">
                                    <li>Company name</li>
                                    <li>Purchase order number</li>
                                    <li>Our invoice number</li>
                                </ul>
                            </li>
                            <li>Follow the on-screen instructions to complete the card payment</li>
                        </ul>
                    </div>
                
                </t>

                <p class="terms mt-1">
                    <span class="font_bold">
                        <u>Terms and Conditions</u>
                    </span>
                    <br/>
                    <br/>
                    <!-- Spantech Products Ltd -->
                    <t t-if="o.company_id.report_format == 'spantech_report'">
                        <span>This documentation has been produced wholly and exclusively with reference to Spantech
                            Products Ltd terms and conditions.
                        </span>
                        <br/>
                        <span>A copy of which can be found at
                            <a href="https://www.spantech.co.uk/how-to-buy">https://www.spantech.co.uk/how-to-buy</a>
                            <!--<b>Or</b>-->
                            <!--<a href="https://splail.odoo.com/terms">https://splail.odoo.com/terms</a>-->
                        </span>
                        <br/>
                        <br/>
                        <span>It has come to our attention that somebody has contacted one of our customers claiming
                            that
                            our bank details have changed.
                            Our bank details have NOT changed. All our bank details remain the same without any
                            alterations.
                            Please report any bank change request to us via a confirmed secure method and do not respond
                            to
                            bank change request.
                        </span>
                        <br/>
                    </t>
                    <t t-if="o.company_id.report_format == 'mjs_report'">
                        <span t-field="o.company_id.invoice_terms"/>
                        <br/>
                    </t>
                    <!-- Spancan n Equipment Ltd -->
                    <t t-elif="o.company_id.report_format == 'spancan_n_equipment_report'">
                        <!--<span>Our responsibility ceases after the goods leaves our Godown. Goods are always dispatched-->
                            <!--at Buyer's risk unless otherwise instructed. tnterest@24% p.a. would be charged extra if not-->
                            <!--paid within due date.-->
                        <!--</span>-->
                        <!--<br/>-->
                        <span>Payment should be made by A/c.Payee Bank Draft/Cheque only.</span>
                        <br/>
                        <span>All disputes subject to Kolkata Jurisdiction only.</span>
                        <br/>
                        <br/>
                    </t>
                </p>

                <div class="oe_structure"/>
                <p t-field="doc.note"/>

            </div>
        </t>

    </template>

    <template id="report_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Spantech Products Ltd -->
                <t t-if="doc.company_id.report_format == 'spantech_report'">
                    <t t-call="pdf_report.saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <!-- Spancan n Equipment Ltd -->
                <t t-elif="doc.company_id.report_format == 'spancan_n_equipment_report'">
                    <t t-call="pdf_report.saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <!-- AG Gases & Equipment Ltd -->
                <t t-elif="doc.company_id.report_format == 'ag_gases_report'">
                    <t t-call="pdf_report.ag_gases_saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <!-- Micro Material Ltd -->
                <t t-elif="doc.company_id.report_format == 'MML_report'">
                    <t t-call="pdf_report.mml_saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <!-- Spantech SP Zoo -->
                <t t-elif="doc.company_id.report_format == 'sspzoo_report'">
                    <t t-call="pdf_report.spz_saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <t t-elif="doc.company_id.report_format == 'mjs_report'">
                    <t t-call="pdf_report.saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <t t-else="">
                    <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_saleorder_pro_forma">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="True"/>
            <t t-set="docs" t-value="docs.with_context(proforma=True)"/>
            <t t-foreach="docs" t-as="doc">
                <!-- Spantech Products Ltd -->
                <t t-if="doc.company_id.report_format == 'spantech_report'">
                    <t t-call="pdf_report.saleorder_document" t-lang="doc.partner_id.lang"/>
                </t>
                <!-- Spancan n Equipment Ltd -->
                <t t-elif="doc.company_id.report_format == 'spancan_n_equipment_report'">
