<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mml_report_purchasequotation_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="forced_vat"
               t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
            <t t-set="address">
                <div t-field="o.partner_id"
                     t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;, &quot;email&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                <p t-if="o.partner_id.vat"><t t-esc="o.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                    <span t-field="o.partner_id.vat"/>
                </p>
            </t>
            <t t-if="o.dest_address_id">
                <t t-set="information_block">
                    <strong>Shipping address:</strong>
                    <div t-field="o.dest_address_id"
                         t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
                         name="purchase_shipping_address"/>
                </t>
            </t>
            <t t-else="">
                <t t-set="information_block">
                    <strong>Shipping address:</strong>
                    <div t-if="o.picking_type_id and o.picking_type_id.warehouse_id">
                        <span t-field="o.picking_type_id.warehouse_id.name"/>
                        <div t-field="o.picking_type_id.warehouse_id.partner_id"
                             t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                    </div>
                </t>
            </t>
            <div class="row">
                <div class="col-3">
                    <span>
                        <strong>Name:</strong>
                        <br/>
                    </span>
                    <span t-field="o.user_id.name"/>
                    <br/>
                    <span t-field="o.user_id.email"/>
                </div>
                <div class="col-3">
                    <span>
                        <strong>RFQ Sent Date:</strong>
                        <br/>
                    </span>
                    <span t-field="o.create_date"/>
                </div>
            </div>
            <div class="page">
                <div class="oe_structure"/>

                <h2>Request for Quotation
                    <span t-field="o.name"/>
                </h2>
                <div id="informations" class="row mt16 mb16">
                    <div t-if="o.incoterm_id" class="col-3 bm-2">
                        <strong>Incoterm:</strong>
                        <p t-field="o.incoterm_id.code" class="m-0"/>
                    </div>
                </div>


                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th name="th_description">
                                <strong>Description</strong>
                            </th>
                            <!--<th name="th_expected_date" class="text-center">-->
                            <!--    <strong>Expected Date</strong>-->
                            <!--</th>-->
                            <th name="th_quantity" class="text-right">
                                <strong>Qty</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line" t-as="order_line">
                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if order_line.display_type == 'line_section' else 'font-italic o_line_note' if order_line.display_type == 'line_note' else ''">
                                <t t-if="not order_line.display_type">
                                    <td id="product">
                                        <span t-field="order_line.name"/>
                                    </td>
                                    <!--<td class="text-center">-->
                                    <!--    <span t-field="order_line.date_planned"/>-->
                                    <!--</td>-->
                                    <td class="text-right">
                                        <span t-field="order_line.product_qty"/>
                                        <span t-field="order_line.product_uom" groups="uom.group_uom"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td colspan="99" id="section">
                                        <span t-field="order_line.name"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!--<p t-field="o.notes"/>-->
                <p class="terms mt-1">
                    <div style="width:800px; border:15px solid lightgrey;" name="extra_details">
                        <p t-field="o.notes"/>
                    </div>
                </p>
                <br/>
                <span>This order is subject to our standard Terms &amp; Conditions of Purchase
                    <br/>
                    <br/>Opening hours: Mon-Fri, 8.30am – 5pm (excluding bank holidays).
                    <br/>
                </span>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="mml_report_purchasequotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pdf_report.mml_report_purchasequotation_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>