<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cac_nkd_label_report_pdf" name="A5 - 3 Rows, Side by Side Labels">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="docs[0]" />
            <style>
                .o_report_layout_standard {
                  padding: 0 !important;
                  margin: 0 !important;
                }
        
                .label-sheet {
                  width: 100%;
                  height: 100%;
                  margin: 0;
                  padding: 0;
                }
        
                .label-table {
                  width: 100%;
                  table-layout: fixed;
                  border-collapse: collapse;
                }
        
                .label-row {
                  height: 52mm;
                }
        
                .label-cell {
                  width: 45%;
                  <!--border: 1px solid #000;-->
                  vertical-align: top;
                  padding: 2mm;
                  box-sizing: border-box;
                }
                .ghs_logo{
                    <!--width: 10%;-->
                    overflow: visible !important;
                    white-space: nowrap;
                }
        
                .label-content {
                  font-size: 12px;
                  height: 100%;
                }
                .border0{
                    border:0px solid #ffffff!important;
                }
            </style>

            <div class="label-sheet">
                <table class="label-table border0">
                    <tr class="label-row">
                        <td class="label-cell">
                            <div class="label-content">
                                <div style="width: 100%; clear: both;">
                                    <span style="float: left;" t-esc="docs.product_id.default_code"/>
                                    <span style="float: right;" t-esc="docs.name + '-1'"/>
                                </div>
                                <div style="width: 100%; clear: both; text-align: right; margin-top: 20px; margin-bottom: 2px;">
                                    <t t-if="docs.get_valid_until_date_dateformat()">
                                        Valid Until: 
                                        <span class="ml4" t-esc="docs.get_valid_until_date_dateformat()"/>
                                    </t>
                                    <t t-else="">
                                        Valid Until: <span class="ml4">-</span>
                                    </t>
                                </div>
                            </div>
                            <div class="label-content">
                                <table class="border0" style="width: 100%;">
                                    <tr>
                                        <td style="text-align: left; vertical-align: top; width: 100%;">
                                            <t t-foreach="docs.components_ids" t-as="components">
                                                <div style="line-height: 10px; margin: 0; padding: 0;">
                                                    <span t-esc="components.requested_value"/>
                                                    <span style="margin-left: 4px;" t-esc="components.component"/>
                                                </div>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
