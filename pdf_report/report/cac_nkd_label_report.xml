                            <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                                <t t-if="docs.product_id.nrc_imgs == 'nrc1'">
                                    <img src="/pdf_report/static/src/imgs/all-in-gas-nrc/NRC1_2/compressed_gas_diamond.png"
