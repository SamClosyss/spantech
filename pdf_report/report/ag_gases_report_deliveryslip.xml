<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="ag_gases_report_delivery_document">
        <t t-call="pdf_report.spantech_layout_standard">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="partner" t-value="o.partner_id or (o.move_lines and o.move_lines[0].partner_id) or False"/>
            <br/>
            <br/>
            <div class="page delivery-slip">
                <table class="table table-sm o_main_table address_table" name="delivery_slip_table">
                    <thead>
                        <tr class="bg-lightgrey">
                            <th class="text-left">
                                <span class="text-bold">Invoice to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">Ship to</span>
                            </th>
                            <th class="text-left">
                                <t t-if="o.sale_id and o.sale_id.invoice_ids">
                                    <span class="text-bold">Invoice No</span>
                                </t>
                                <t t-else="">
                                    <span class="text-bold">AG Delivery number</span>
                                </t>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="address_tbody">
                        <tr>
                            <td class="text-left">
                                <t t-if="o.sale_id and o.sale_id.partner_invoice_id">
                                    <h6 t-field="o.sale_id.partner_invoice_id.name"/>
                                    <p>
                                        <span t-if="o.sale_id.partner_invoice_id.street">
                                            <t t-esc="o.sale_id.partner_invoice_id.street"/>
                                        </span>
                                        <span t-if="o.sale_id.partner_invoice_id.street2">
                                            <t t-esc="o.sale_id.partner_invoice_id.street2"/>
                                        </span>
                                        <span t-if="o.sale_id.partner_invoice_id.city">
                                            <t t-esc="o.sale_id.partner_invoice_id.city"/>
                                        </span>
                                        <span t-if="o.sale_id.partner_invoice_id.zip">
                                            <t t-esc="o.sale_id.partner_invoice_id.zip"/>
                                        </span>
                                        <span t-if="o.sale_id.partner_invoice_id.country_id">
                                            <t t-esc="o.sale_id.partner_invoice_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="o.partner_id">
                                    <h6 t-field="o.partner_id.name"/>
                                    <p>
                                        <span t-if="o.partner_id.street">
                                            <t t-esc="o.partner_id.street"/>
                                        </span>
                                        <span t-if="o.partner_id.street2">
                                            <t t-esc="o.partner_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_id.city">
                                            <t t-esc="o.partner_id.city"/>
                                        </span>
                                        <span t-if="o.partner_id.zip">
                                            <t t-esc="o.partner_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_id.country_id">
                                            <t t-esc="o.partner_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="o.sale_id and o.sale_id.invoice_ids">
                                    <span t-field="o.sale_id.invoice_ids"/>
                                </t>
                                <t t-elif="o.name">
                                    <span t-field="o.ag_delivery_no"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Attn</h6>
                                <t t-if="o.partner_id and o.partner_id.x_studio_contact_name">
                                    <span t-field="o.partner_id.x_studio_contact_name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Shipping</h6>
                                <t t-if="o.sale_id">
                                    <span t-field="o.sale_id.shipping_info"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>AG Reference number</h6>
                                <t t-if="o.origin">
                                    <span t-field="o.origin"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <!--<h6>Responsible:</h6>-->
                                <h6>Customer Purchase Order No</h6>
                                <t t-if="o.sale_id and o.sale_id.client_order_ref">
                                    <span t-field="o.sale_id.client_order_ref"/>
                                </t>
                                <t t-elif="o.user_id">
                                    <span t-field="o.user_id"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Tracking Number</h6>
                                <t t-if="o.carrier_tracking_ref">
                                    <span t-field="o.carrier_tracking_ref"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Date</h6>
                                <!--<strong>Shipping Date:</strong>-->
                                <t t-if="o.state == 'done'">
                                    <!--<p t-field="o.date_done"/>-->
                                    <span t-esc="o.date_done.date()"/>
                                </t>
                                <t t-if="o.state != 'done'">
                                    <!--<p t-field="o.scheduled_date"/>-->
                                    <span t-esc="o.scheduled_date.date()"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Customers RFQ</h6>
                                <t t-if="o.sale_id and o.sale_id.client_order_rfq">
                                    <span t-field="o.sale_id.client_order_rfq"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>WO Incoterm</h6>
                                <t t-if="o.sale_id and o.sale_id.wo_incoterm">
                                    <span t-field="o.sale_id.wo_incoterm"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td/>
                        </tr>
                    </tbody>
                </table>

                <table class="table table-sm o_main_table product_table" t-if="o.state!='done'" name="stock_move_table">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr class="bg-lightgrey">
                            <th name="th_index" class="text-center">
                                <span>No.</span>
                            </th>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_net_weight" class="text-center">Net Weight</th>
                            <th name="th_gross_weight" class="text-center">Gross Weight</th>
                            <th name="th_quantity" class="text-center">Ordered</th>
                            <th name="th_priceunit" class="text-center">Delivered</th>
                        </tr>
                    </thead>
                    <t t-set="index" t-value="1"/>
                    <tbody class="delivery_slip_tbody">
                        <t t-set="lines" t-value="o.move_line_ids.filtered(lambda x: x.product_uom_qty)"/>
                        <t t-set="total_net_weight" t-value="0"/>
                        <t t-set="total_gross_weight" t-value="0"/>
                        <t t-foreach="lines" t-as="move">
                            <tr>
                                <t>
                                    <td class="text-center" name="product_index" style="vertical-align: middle;">
                                        <span t-esc="index"/>
                                    </td>
                                    <td name="td_name">
                                        <span class="py-2" t-field="move.product_id.default_code"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <p class="bold_font">
                                            <t t-esc="move.name"/>
                                            <t t-if="move.product_tmpl_notes">
                                                <br/>
                                                <t t-esc="move.product_tmpl_notes"/>
                                            </t>
                                        </p>
                                        <t t-if="move.product_id.un_number">
                                            UN Number[<span class="pb-1" t-field="move.product_id.un_number"
                                                            t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="move.product_id.shipping_name">
                                            Shipping Name[<span t-field="move.product_id.shipping_name"
                                                                t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="move.product_id.product_class">
                                            Class[<span class="pb-1" t-field="move.product_id.product_class"
                                                        t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="move.product_id.tunnel_code">
                                            Tunnel Code[<span t-field="move.product_id.tunnel_code"
                                                              t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="move.product_id.sds_number">
                                            SDS Number[<span t-field="move.product_id.sds_number"
                                                             t-options="{'widget': 'text'}"/>]
                                        </t>
                                    </td>
                                    <td name="td_net_weight" class="text-center">
                                        <span t-field="move.product_id.net_weight"/>
                                        <!--<t t-set="total_net_weight"-->
                                        <!--t-value="total_net_weight+float(move.product_id.net_weight)"/>-->
                                        <t t-set="total_net_weight"
                                           t-value="total_net_weight+float(move.product_id.net_weight)*float(move.product_uom_qty)"/>
                                    </td>
                                    <td name="t_gross_weight" class="text-center">
                                        <span t-field="move.product_id.gross_weight"/>
                                        <!--<t t-set="total_gross_weight"-->
                                        <!--t-value="total_gross_weight+float(move.product_id.gross_weight)"/>-->
                                        <t t-set="total_gross_weight"
                                           t-value="total_gross_weight+float(move.product_id.gross_weight)*float(move.product_uom_qty)"/>
                                    </td>
                                    <td name="td_quantity" class="text-center">
                                        <span t-field="move.product_uom_qty"/>
                                        <span t-field="move.product_uom"/>

                                    </td>
                                    <td name="td_priceunit" class="text-center">
                                        <span t-field="move.quantity_done"/>
                                        <span t-field="move.product_uom"/>
                                    </td>
                                </t>
                            </tr>
                            <t t-set="index" t-value="index + 1"/>
                        </t>
                        <tr>
                            <td></td>
                            <td class="text-center">
                                <b>Total Net and Gross Weight of Consignment</b>
                            </td>
                            <td class="text-center">
                                <span t-esc="total_net_weight"/>
                            </td>
                            <td class="text-center">
                                <span t-esc="'%.2f'%total_gross_weight"/>
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>

                <!-- TODO: It's core changes -->
                <table class="table table-sm mt48" t-if="o.move_line_ids and o.state=='done'"
                       name="stock_move_line_table">
                    <t t-set="has_serial_number" t-value="False"/>
                    <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"
                       groups="stock.group_lot_on_delivery_slip"/>
                    <thead>
                        <tr>
                            <th name="th_sml_product">
                                <strong>Product</strong>
                            </th>
                            <t name="lot_serial" t-if="has_serial_number">
                                <th>
                                    Lot/Serial Number
                                </th>
                            </t>
                            <th name="th_sml_qty_ordered" class="text-center" t-if="not has_serial_number">
                                <strong>Ordered</strong>
                            </th>
                            <th name="th_sml_quantity" class="text-center">
                                <strong>Delivered</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- This part gets complicated with different use cases (additional use cases in extensions of this report):
                                1. If serial numbers are used and set to print on delivery slip => print lines as is, otherwise group them by overlapping
                                    product + description + uom combinations
                                2. If any packages are assigned => split products up by package (or non-package) and then apply use case 1 -->
                        <!-- If has destination packages => create sections of corresponding products -->
                        <t t-if="o.has_packages" name="has_packages">
                            <t t-set="packages" t-value="o.move_line_ids.mapped('result_package_id')"/>
                            <t t-foreach="packages" t-as="package">
                                <t t-call="stock.stock_report_delivery_package_section_line"/>
                                <t t-set="package_move_lines"
                                   t-value="o.move_line_ids.filtered(lambda l: l.result_package_id == package)"/>
                                <!-- If printing lots/serial numbers => keep products in original lines -->
                                <t t-if="has_serial_number">
                                    <tr t-foreach="package_move_lines" t-as="move_line">
                                        <t t-set="product_weight" t-value="true"/>
                                        <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                    </tr>
                                </t>
                                <!-- If not printing lots/serial numbers => merge lines with same product+description+uom -->
                                <t t-else="">
                                    <t t-set="aggregated_lines"
                                       t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                                    <t t-set="product_weight" t-value="true"/>
                                    <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                                </t>
                            </t>
                            <!-- Make sure we do another section for package-less products if they exist -->
                            <t t-set="move_lines"
                               t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                            <t t-set="aggregated_lines"
                               t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                            <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                                <t t-call="stock.stock_report_delivery_no_package_section_line"
                                   name="no_package_section"/>
                                <t t-if="has_serial_number">
                                    <tr t-foreach="move_lines" t-as="move_line">
                                        <t t-set="product_weight" t-value="true"/>
                                        <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                    </tr>
                                </t>
                                <t t-elif="aggregated_lines">
                                    <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                                </t>
                            </t>
                        </t>
                        <!-- No destination packages -->
                        <t t-else="">
                            <!-- If printing lots/serial numbers => keep products in original lines -->
                            <t t-if="has_serial_number">
                                <tr t-foreach="o.move_line_ids" t-as="move_line">
                                    <t t-set="product_weight" t-value="true"/>
                                    <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                </tr>
                            </t>
                            <!-- If not printing lots/serial numbers => merge lines with same product -->
                            <t t-else="" name="aggregated_move_lines">
                                <t t-set="aggregated_lines"
                                   t-value="o.move_line_ids._get_aggregated_product_quantities()"/>
                                <t t-set="product_weight" t-value="true"/>

                                <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                            </t>
                        </t>
                    </tbody>
                </table>
                <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                <t t-if="o.backorder_ids and backorders">
                    <p class="mt-5">
                        <span>Remaining quantities not yet delivered:</span>
                    </p>
                    <table class="table table-sm" name="stock_backorder_table" style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <th name="th_sb_product">
                                    <strong>Product</strong>
                                </th>
                                <th/>
                                <th name="th_sb_quantity" class="text-center">
                                    <strong>Quantity</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="backorders" t-as="backorder">
                                <t t-set="bo_lines"
                                   t-value="backorder.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="bo_lines" t-as="bo_line">
                                    <td class="w-auto">
                                        <span t-field="bo_line.product_id"/>
                                        <p t-if="bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                            <span t-field="bo_line.description_picking"/>
                                        </p>
                                    </td>
                                    <td/>
                                    <td class="text-center w-auto">
                                        <span t-field="bo_line.product_uom_qty"/>
                                        <span t-field="bo_line.product_uom"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <div t-if="o.signature" class="mt32 ml64 mr4" name="signature">
                    <div class="offset-8">
                        <strong>Signature</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                    <div class="offset-8 text-center">
                        <p t-field="o.partner_id.name"/>
                    </div>
                </div>

                <br/>
                <!-- https://spantech.odoo.com/web#id=480&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
                <p t-if="o.sale_id and o.sale_id.is_IGM_customer" class="terms mt-1">
                    <span class="font_bold" style="font-size:20px">
                        <u>For IGM Declaration</u>
                    </span>
                    <br/>
                    <table name="IFM_Info" class="table table-sm o_main_table address_table" style="width:70%;">
                        <tbody>
                            <tr>
                                <td class="text-center" style="width:20%;">Consignee Name</td>
                                <td class="text-center">
                                    <span t-field="o.sale_id.consignee_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Notify Party</td>
                                <td class="text-center">
                                    <span t-field="o.sale_id.notify_party"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Value For Customs with Currency</td>
                                <td class="text-center">
                                    <span t-field="o.sale_id.value_for_customs_with_currency"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Gross Weight</td>
                                <td class="text-center">
                                    <span t-field="o.sale_id.manifested_gross_weight"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Packages</td>
                                <td class="text-center">
                                    <span t-field="o.sale_id.manifested_packages"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Descrition of Goods</td>
                                <td class="text-center">
                                    <span t-field="o.sale_id.description_of_goods"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </p>

                <br/>
                <br/>
                <p class="terms mt-1">
                    <span class="font_bold">
                        <u>Terms and Conditions</u>
                    </span>
                    <br/>
                    <br/>
                    <span>This documentation has been produced wholly and exclusively with reference to AG Gases and
                        Equipment Ltd terms and conditions. A copy of which can be ordered from our sales team.
                    </span>
                    <br/>
                </p>
                <br/>
                <br/>
                <p class="terms mt-1">
                    <div class="extra_details_box" name="extra_details">
                        <p t-field="o.delivery_notes"/>
                    </div>
                </p>

            </div>
        </t>
    </template>

    <template id="stock_report_delivery_has_serial_move_line_inherit_weight" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td/p[@t-if]" position="after">
            <t t-if="product_weight">
                <t t-if="move_line.product_id and move_line.product_id.gross_weight">
                    <b>Gross Weight: </b><span t-field="move_line.product_id.gross_weight"/>
                </t>
                <t t-if="move_line.product_id and move_line.product_id.net_weight">
                    <b>Net Weight: </b><span t-field="move_line.product_id.net_weight"/>
                </t>
            </t>
        </xpath>
    </template>

    <template id="stock_report_delivery_aggregated_move_lines_inherit_weight" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td/p" position="inside">
            <t t-if="product_weight">
                <br/>
                <t t-if="aggregated_lines[line]['product'] and aggregated_lines[line]['product'].gross_weight">
                    <b>Gross Weight: </b><span t-esc="aggregated_lines[line]['product'].gross_weight"/>
                </t>
                <t t-if="aggregated_lines[line]['product'] and aggregated_lines[line]['product'].net_weight">
                    <b>Net Weight: </b><span t-esc="aggregated_lines[line]['product'].net_weight"/>
                </t>
            </t>
        </xpath>
    </template>


</odoo>
