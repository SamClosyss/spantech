                .o_report_layout_standard {
                    padding: 0 !important;
                    margin: 0 !important;
                }
            
                .label-sheet {
                    margin-left: 78.5px;
                    padding: 0;
                    max-width: 170mm; <!--2 boxes with gaps (80mm * 2 + 3mm gap) + margin buffer-->
                }
            
                .label-table {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 3mm 3mm; /* Horizontal and vertical gap */
                }
            
                .label-box {
                    width: 94mm;
                    height: 92mm;
                    border: 0; <!--1px solid #000-->
                    border-radius: 1.5mm;
                    box-sizing: border-box;
                    
                    overflow: hidden; <!--Prevent content from expanding box-->
                    display: flex; <!--Optional: helps align inner content-->
                    flex-direction: column; <!--Allows stacking child content vertically-->
                    justify-content: flex-start; <!--Or center, if needed-->
                    
                    margin: 0 auto;
                    padding: 4mm;
                    text-align: left;
                }
                .label-cell {
                    width: 94mm;
                    height: 92mm;
                    padding: 0;
                    margin: 0;
                    overflow: hidden;
                    vertical-align: top;
                    
                    text-align: center; 
                    
                }
                .border0{
                    border:0px solid #ffffff!important;
                }
