<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ag_gases_shipping_invoice_document">
        <t t-call="pdf_report.mml_layout_standard">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <br/>
            <br/>
            <div class="page invoice-receipt">
                <table class="table table-sm o_main_table address_table" name="invoice_line_table">
                    <thead>
                        <tr class="bg-lightgrey">
                            <th class="text-left">
                                <span class="text-bold">Invoice to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">Ship to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">Document No:</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="address_tbody">
                        <tr>
                            <td class="text-left">
                                <t t-if="o.partner_id">
                                    <h6 t-field="o.partner_id.name"/>
                                    <p>
                                        <span t-if="o.partner_id.street">
                                            <t t-esc="o.partner_id.street"/>
                                        </span>
                                        <span t-if="o.partner_id.street2">
                                            <t t-esc="o.partner_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_id.city">
                                            <t t-esc="o.partner_id.city"/>
                                        </span>
                                        <span t-if="o.partner_id.zip">
                                            <t t-esc="o.partner_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_id.country_id">
                                            <t t-esc="o.partner_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="o.partner_shipping_id">
                                    <h6 t-field="o.partner_shipping_id.name"/>
                                    <p>
                                        <span t-if="o.partner_shipping_id.street">
                                            <t t-esc="o.partner_shipping_id.street"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.street2">
                                            <t t-esc="o.partner_shipping_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.city">
                                            <t t-esc="o.partner_shipping_id.city"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.zip">
                                            <t t-esc="o.partner_shipping_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.country_id">
                                            <t t-esc="o.partner_shipping_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="o.sale_order_id">
                                    <span t-field="o.sale_order_id.name"/>
                                </t>
                                <t t-elif="o.name">
                                    <span t-field="o.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Attn:</h6>
                                <t t-if="o.partner_id and o.partner_id.x_studio_contact_name">
                                    <span t-field="o.partner_id.x_studio_contact_name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Shipping:</h6>
                                <t t-if="o.sale_order_id and o.sale_order_id.shipping_info">
                                    <span t-field="o.sale_order_id.shipping_info"/>
                                </t>
                                <t t-elif="o.partner_shipping_id">
                                    <span t-field="o.partner_shipping_id"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Date</h6>
                                <t t-if="o.picking_schedule_date">
                                    <span t-esc="o.picking_schedule_date.date()"/>
                                </t>
                                <t t-elif="o.invoice_date">
                                    <span t-field="o.invoice_date"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Customers PO:</h6>
                                <t t-if="o.sale_order_id.client_order_ref">
                                    <span t-esc="o.sale_order_id.client_order_ref"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Incoterms</h6>
                                <t t-if="o.invoice_incoterm_id">
                                    <span t-field="o.invoice_incoterm_id"/>
                                </t>
                                <t t-elif="o.sale_order_id and o.sale_order_id.wo_incoterm">
                                    <span t-field="o.sale_order_id.wo_incoterm"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Payment terms:</h6>
                                <t t-if="o.invoice_payment_term_id">
                                    <span t-field="o.invoice_payment_term_id"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <table class="table table-sm o_main_table product_table" name="invoice_line_table">
                    <thead>
                        <tr class="bg-lightgrey">
                            <th name="th_index" class="text-left">
                                <span>No.</span>
                            </th>
                            <th name="th_description" class="text-left">
                                <span>Description</span>
                            </th>
                            <th name="th_quantity" class="text-right">
                                <span>Quantity</span>
                            </th>
                            <th name="th_quantity" class="text-right">
                                <span>UOM</span>
                            </th>
                            <th name="th_priceunit"
                                t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Unit Price</span>
                            </th>
                            <th name="th_price_unit" t-if="display_discount"
                                t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_taxes"
                                t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Taxes</span>
                            </th>
                            <th name="th_subtotal" class="text-right">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <t t-set="index" t-value="1"/>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="lines"
                           t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                        <t t-set="total_net_weight" t-value="0"/>
                        <t t-set="total_gross_weight" t-value="0"/>
                        <t t-foreach="lines" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                               groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                               groups="account.group_show_line_subtotals_tax_included"/>
                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                    <td class="text-right" name="product_index" style="vertical-align: middle;">
                                        <span t-esc="index"/>
                                    </td>
                                    <td name="account_invoice_line_name">
                                        <span class="py-2" t-field="line.product_id.default_code"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <p class="bold_font">
                                            <t t-esc="line.name"/>
                                            <t t-if="line.product_tmpl_notes">
                                                <br/>
                                                <t t-esc="line.product_tmpl_notes"/>
                                            </t>
                                            <br/>
                                            <t t-if="line.subtotal_gross_weight">
                                                <b>Gross Weight:</b> <span class="text-nowrap" t-field="line.subtotal_gross_weight"/>KG
                                            </t>
                                            <t t-if="line.subtotal_net_weight">
                                                <b>Net Weight:</b> <span class="text-nowrap" t-field="line.subtotal_net_weight"/>KG
                                            </t>
                                            <t t-set="total_net_weight" t-value="total_net_weight + line.subtotal_net_weight"/>
                                            <t t-set="total_gross_weight" t-value="total_gross_weight + line.subtotal_gross_weight"/>
                                        </p>
                                        <span class="pb-1" t-field="line.product_id.x_studio_additional_description"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        Country of Origin:
                                        <span t-field="line.product_tmpl_country_of_origin"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        HS Code:
                                        <span t-field="line.product_tmpl_hs_code"
                                              t-options="{'widget': 'text'}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td class="text-right">
                                        <span class="text-nowrap" t-field="line.product_uom_id"/>
                                    </td>
                                    <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap" t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount"
                                        t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap" t-field="line.discount"/>
                                    </td>
                                    <td t-attf-class="text-left {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"
                                              id="line_tax_ids"/>
                                    </td>
                                    <td class="text-right o_price_total">
                                        <span class="text-nowrap" t-field="line.price_subtotal"
                                              groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span class="text-nowrap" t-field="line.price_total"
                                              groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                            </tr>
                            <t t-set="index" t-value="index + 1"/>
                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-right">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                                t-esc="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div id="total" class="row border-dark border mx-0" style="border-width: 2px !important;">
                        <div class="col-7">
                        </div>
                        <div class="col-5 p-0 align-self-stretch d-flex">
                            <table class="table table-sm border border-dark total_table"
                                   style="page-break-inside: avoid;color: black;font-weight: bold;">

                                <!--Tax totals -->
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>

                            </table>
                        </div>
                    </div>
                    <div id="total" class="row border-dark border mx-0" style="border-width: 2px !important;">
                        <div class="col-7">
                        </div>
                        <div class="col-5 p-0 align-self-stretch d-flex">
                            <table class="table table-sm border border-dark total_table"
                                   style="page-break-inside: avoid;color: black;font-weight: bold;">
                                <tr class="text-nowrap o_subtotal">
                                    <td width="40%" class="text-end o_price_total">Total Net Weight</td>
                                    <td class="text-end o_price_total">
                                        <t t-esc="'%.2f'%total_net_weight"/>KG
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div id="total" class="row border-dark border mx-0" style="border-width: 2px !important;">
                        <div class="col-7">
                        </div>
                        <div class="col-5 p-0 align-self-stretch d-flex">
                            <table class="table table-sm border border-dark total_table"
                                   style="page-break-inside: avoid;color: black;font-weight: bold;">
                                <tr class="text-nowrap o_subtotal">
                                    <td width="40%" class="text-end o_price_total">Total Gross Weight</td>
                                    <td class="text-end o_price_total">
                                        <t t-esc="'%.2f'%total_gross_weight"/>KG
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div id="total" class="row border-dark border mx-0" style="border-width: 2px !important;">
                        <div class="col-7">
                            <table class="table borderless exporter_table">
                                <tr>
                                    <td colspan="2"><b>Exporter Micromaterials Limited - Address in header</b></td>
                                </tr>
                                <tr>
                                    <td>Reason for Export</td>
                                    <td><span t-field="o.sale_order_id.reason_for_export"/></td>
                                </tr>
                                <tr>
                                    <td >Number Of Packages</td>
                                    <td ><span t-field="o.picking_packages_number"/></td>
                                </tr>
                                <tr>
                                    <td >Package Details</td>
                                    <td ><span t-field="o.picking_delivery_note"/></td>
                                </tr>
                                <tr>
                                    <td >Delivery Terms</td>
                                    <td > <span t-field="o.sale_order_id.wo_incoterm"/></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-5 p-0 align-self-stretch d-flex">
                        </div>
                    </div>
                    <div id="total" class="row mx-0" style="border:none !important;">
                        <div class="col-9" style="border:none !important;">
                            <table class="table borderless exporter_table2" style="border:none !important;">
                                <tr>
                                    <td colspan="2"><b>I Declare that the above information is true and correct to the best of my knowledge.<br/>For and on behalf the above named company</b></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td >Name : <span t-field="o.picking_user_id.name"/></td>
                                    <td >Signature</td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td ></td>
                                    <td >Date : <span t-field="o.picking_date_done"/></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-4 p-0 align-self-stretch d-flex">
                        </div>
                    </div>

                </div>

                <br/>

            </div>

        </t>

    </template>

</odoo>
