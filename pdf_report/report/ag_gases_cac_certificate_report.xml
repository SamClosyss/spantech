                    <div style="display:inline-block;justify-content: center;width:100%;font-size:12px;margin-top:-5px;">
                        <t t-if="docs.product_id.nrc_imgs == 'nrc1'" t-out="docs.product_id.nrc1_cac_new"/>
                        <t t-if="docs.product_id.nrc_imgs == 'nrc4'" t-out="docs.product_id.nrc4_cac_new"/>
                        <t t-if="docs.product_id.nrc_imgs == 'nrc5'" t-out="docs.product_id.nrc5_cac_new"/>
