                    <table style="border:0px dashed #ffffff !important;padding: 0px; bottom:0;"
	                    class="table">
	                     <tbody>
	                         <tr style="border:0px dashed #D3D3D3 !important;font-size:12px;">
	                             <td style="border:0px dashed #ccc !important; width:55%!important; padding-left:0px;">
	                                 <t t-esc="docs.product_id.un_number"/>
	                                 <t t-esc="docs.product_id.shipping_name"/>
	                                 <br/>
	                                 <t t-esc="docs.product_id.net_weight"/>
	                             </td>
	                             <td t-if="docs.product_id.nrc_imgs in ['nrc4','nrc5']" style="border:0px dashed #D3D3D3 !important; width:10%!important;">
	                                 <img src="/pdf_report/static/src/imgs/nrc4_cac_certificate.png" style="width:100%;"/>
	                             </td>
	                             <td style="border:0px dashed #D3D3D3 !important; width:10%!important;">
	                                 <img src="/pdf_report/static/src/imgs/compressed_gas_diamond.png" style="width:100%; background-color:#ffffff;"/>
	                             </td>
	                         </tr>
