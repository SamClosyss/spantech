<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mml_invoice_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="forced_vat"
               t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
            <div class="page invoice-receipt">
                <u>
                    <h2 style="text-align:center;">
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                        <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                        <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                        <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                        <span t-if="o.name != '/'" t-field="o.name"/>
                        <!--<span t-if="o.partner_id != '/'" t-field="o.partner_id.name"/>-->
                    </h2>
                </u>
                <br/>
                <div id="informations" class="row mt32 mb32">
                    <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id" name="invoice_address">
                        <strong>Invoice Address:</strong>
                        <address t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2" name="invoice_contact">
                        <strong>Contact:</strong>
                        <t t-if="o.partner_id and o.partner_id.x_studio_contact_name">
                            <span t-field="o.partner_id.x_studio_contact_name"/>
                            <br/>
                            Tel:
                            <br/>
                            Email:
                        </t>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2" name="payment_terms">
                        <strong>Payment Terms:</strong>
                        <t t-if="o.invoice_payment_term_id">
                            <p class="m-0" t-field="o.invoice_payment_term_id.name"/>
                        </t>
                        <br/>
                        <strong>Your Vat No:</strong>
                        <t t-if="o.partner_id.vat">
                            <p class="m-0" t-field="o.partner_id.vat"/>
                        </t>
                        <!--<br/>-->
                        <!--<strong>Contact:</strong>-->
                        <!--<br/>-->
                        <!--Name: Marcela Garner-->
                        <!--<br/>-->
                        <!--Tel: 01509 227 538-->
                        <!--<br/>-->
                        <!--Email: m.garner@lboro.ac.uk-->
                    </div>
                </div>
                <div id="informations_2" class="row mt32 mb32">
                    <div class="col-auto col-3 mw-100 mb-2" name="contact_detail">
                        Tel:
                        <span class="m-0" t-field="o.partner_id.phone"/>
                        <br/>
                        Email:
                        <span class="m-0" t-field="o.partner_id.email"/>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2"/>
                    <div class="col-auto col-3 mw-100 mb-2" name="contact_detail_2">
                        <strong>Contact:</strong>
                        <t t-if="o.invoice_user_id">
                            <span class="m-0" t-field="o.invoice_user_id.name"/>
                            Tel:
                            <span class="m-0" t-field="o.invoice_user_id.phone"/>
                            <br/>
                            Email:
                            <span class="m-0" t-field="o.invoice_user_id.email"/>
                        </t>
                    </div>
                </div>

                <div id="informations_2" class="row mt32 mb32">
                    <div class="col-auto col-6 mw-100 mb-2" name="order_no">
                        <strong>Customer Order No:</strong>
                        <t t-if="o.sale_order_id and o.sale_order_id.client_order_ref">
                            <span class="m-0" t-field="o.sale_order_id.client_order_ref"/>
                        </t>
                        <t t-elif="o.ref">
                            <span class="m-0" t-field="o.ref"/>
                        </t>
                        <t t-elif="o.sale_order_id">
                            <span class="m-0" t-field="o.sale_order_id.name"/>
                        </t>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-2"/>
                    <div class="col-auto col-3 mw-100 mb-2" name="contact_detail_2">
                        <strong>Date:</strong>
                        <t t-if="o.invoice_date">
                            <span class="m-0" t-field="o.invoice_date"/>
                        </t>
                    </div>
                </div>
                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <table class="table table-sm o_main_table" name="invoice_line_table">
                    <thead>
                        <tr>
                            <th name="th_index" class="text-left">
                                <span>Item</span>
                            </th>
                            <th name="th_quantity" class="text-left">
                                <span>Quantity</span>
                            </th>
                            <th name="th_description" class="text-left">
                                <span>Description</span>
                            </th>
                            <th name="th_priceunit"
                                t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Price</span>
                            </th>
                            <th name="th_subtotal" class="text-center">
                                <!--<span>GBP</span>-->
                                <span t-field="o.currency_id.name"/>
                                <!--<span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>-->
                                <!--<span groups="account.group_show_line_subtotals_tax_included">Total Price</span>-->
                            </th>
                        </tr>
                    </thead>
                    <t t-set="index" t-value="1"/>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="lines"
                           t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                        <t t-foreach="lines" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                               groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                               groups="account.group_show_line_subtotals_tax_included"/>
                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                    <!--<td class="text-left" name="product_index" style="vertical-align: middle;">-->
                                    <td class="text-left" name="product_index">
                                        <span t-esc="index"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="int(line['quantity'])"/>
                                        <!--<span t-field="line.quantity"/>-->
                                    </td>
                                    <td name="account_invoice_line_name">
                                        <span class="py-2" t-field="line.product_id.default_code"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <p class="bold_font">
                                            <t t-esc="line.name"/>
                                            <t t-if="line.product_tmpl_notes">
                                                <br/>
                                                <t t-esc="line.product_tmpl_notes"/>
                                            </t>
                                        </p>
                                        <span class="pb-1" t-field="line.product_id.x_studio_additional_description"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <span t-field="line.product_tmpl_hs_code"
                                              t-options="{'widget': 'text'}"/>
                                        Country of Origin:
                                        <span t-field="line.product_tmpl_country_of_origin"
                                              t-options="{'widget': 'text'}"/>
                                    </td>
                                    <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap" t-field="line.price_unit"/>
                                    </td>
                                    <td class="text-right o_price_total">
                                        <span class="text-nowrap" t-field="line.price_subtotal"
                                              groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span class="text-nowrap" t-field="line.price_total"
                                              groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                            </tr>
                            <t t-set="index" t-value="index + 1"/>
                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-right">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                                t-esc="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <!--<t t-call="account.document_tax_totals"/>-->
                        <!--<tr>-->
                        <!--&lt;!&ndash;<td colspan="4" class="text-right">&ndash;&gt;-->
                        <!--&lt;!&ndash;<strong>Net:</strong>&ndash;&gt;-->
                        <!--&lt;!&ndash;</td>&ndash;&gt;-->
                        <!--&lt;!&ndash;<td class="text-right o_price_total">&ndash;&gt;-->
                        <!--&lt;!&ndash;&lt;!&ndash;Tax totals&ndash;&gt;&ndash;&gt;-->
                        <!--&lt;!&ndash;<t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>&ndash;&gt;-->
                        <!--&lt;!&ndash;<t t-call="pdf_report.mml_document_tax_totals"/>&ndash;&gt;-->
                        <!--&lt;!&ndash;</td>&ndash;&gt;-->
                        <!--<td colspan="4" class="text-right">-->
                        <!--<strong>Net:</strong>-->
                        <!--</td>-->
                        <!--<td>-->
                        <!--<strong>-->
                        <!--<span t-esc="tax_totals['formatted_amount']"/>-->
                        <!--</strong>-->
                        <!--</td>-->
                        <!--<td class="text-right o_price_total">-->
                        <!--<t t-foreach="tax_totals['subtotals']" t-as="subtotal">-->
                        <!--<tr class="border-black o_subtotal">-->
                        <!--<td>-->
                        <!--<strong t-esc="subtotal['name']"/>-->
                        <!--</td>-->

                        <!--<td class="text-right">-->
                        <!--<span t-att-class="oe_subtotal_footer_separator"-->
                        <!--t-esc="subtotal['formatted_amount']"/>-->
                        <!--</td>-->
                        <!--</tr>-->
                        <!--<t t-set="subtotal_to_show" t-value="subtotal['name']"/>-->
                        <!--<t t-call="account.tax_groups_totals"/>-->
                        <!--</t>-->
                        <!--</td>-->
                        <!--</tr>-->
                        <!--<tr>-->
                        <!--<td colspan="4" class="text-right">-->
                        <!--Total amount (GBP):-->
                        <!--</td>-->
                        <!--<td>-->
                        <!--<strong>-->
                        <!--<span t-esc="tax_totals['formatted_amount_total']"/>-->
                        <!--</strong>-->
                        <!--</td>-->
                        <!--</tr>-->
                        <!--<tr>-->
                        <!--<td colspan="4" class="text-right">-->
                        <!--Total amount (GBP):-->
                        <!--</td>-->
                        <!--<td>-->
                        <!--<strong>-->
                        <!--<span t-esc="tax_totals['formatted_amount_total']"/>-->
                        <!--</strong>-->
                        <!--</td>-->
                        <!--</tr>-->
                    </tbody>

                </table>

                <div class="clearfix">
                    <div id="total" class="row">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'}" style="margin-left: auto; margin-right: 0;">
                            <table class="table table-sm"  style="page-break-inside: avoid;color: black;font-weight: bold;">
                                <!--Tax totals  -->
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>

                                <!--Payments-->
                                <t t-if="print_with_payments">
                                    <t t-if="o.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals" />
<!--                                        t-value="o.sudo()._get_reconciled_info_JSON_values()"/>-->
                                       <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>

                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr>
                                                <td>
                                                    <i class="oe_form_field text-right oe_payment_label">Paid on
                                                        <t t-esc="payment_vals['date']" t-options='{"widget": "date"}'/>
                                                    </i>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="payment_vals['amount']"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="len(payments_vals) > 0">
                                            <tr class="border-black">
                                                <td>
                                                    <strong>Amount Due</strong>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="o.amount_residual"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- https://spantech.odoo.com/web#id=480&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
                <p t-if="o.sale_order_id and o.sale_order_id.is_IGM_customer" class="terms mt-1">
                    <span class="font_bold" style="font-size:20px">
                        <u>For IGM Declaration</u>
                    </span>
                    <br/>
                    <table name="IFM_Info" class="table table-sm o_main_table address_table" style="width:70%;">
                        <tbody>
                            <tr>
                                <td class="text-center" style="width:20%;">Consignee Name</td>
                                <td class="text-center">
                                    <span t-field="o.sale_order_id.consignee_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Notify Party</td>
                                <td class="text-center">
                                    <span t-field="o.sale_order_id.notify_party"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Value For Customs with Currency</td>
                                <td class="text-center">
                                    <span t-field="o.sale_order_id.value_for_customs_with_currency"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Gross Weight</td>
                                <td class="text-center">
                                    <span t-field="o.sale_order_id.manifested_gross_weight"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Packages</td>
                                <td class="text-center">
                                    <span t-field="o.sale_order_id.manifested_packages"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Descrition of Goods</td>
                                <td class="text-center">
                                    <span t-field="o.sale_order_id.description_of_goods"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </p>
                <!--<div id="qrcode" t-if="o.display_qr_code and o.amount_residual > 0">-->
                <!--<p t-if="qr_code_urls.get(o.id)">-->
                <!--<strong class="text-center">Scan me with your banking app.</strong>-->
                <!--<br/>-->
                <!--<br/>-->
                <!--<img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>-->
                <!--</p>-->
                <!--</div>-->
                <br/>
                <br/>
                <t t-set="payment_term_details" t-value="o.payment_term_details"/>
                <div t-field="o.invoice_payment_term_id.note" name="payment_term"/>
                <br/>
                <div t-if="not is_html_empty(o.company_id.invoice_terms)" name="terms_default_mml">
                    <p class="terms mt-1">
                        <span class="font_bold">
                            <u>Terms and Conditions</u>
                        </span>
                        <p t-esc="o.company_id.invoice_terms"></p>
                    </p>
                </div>
            </div>
        </t>
    </template>

</odoo>
