                        <td style="width:20%;border: 1px solid;">15:<br/>-
                        </td>
                    </tr>
                    <tr style="width:100%;border: 1px solid;padding:0px;margin:0px">
                        <td style="width:20%;border: 1px solid;">16:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">17:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">18:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">19:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">20:<br/>-
                        </td>
                    </tr>
                    <tr style="width:100%;border: 1px solid;padding:0px;margin:0px">
                        <td style="width:20%;border: 1px solid;">21:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">22:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">23:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">24:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">25:<br/>-
                        </td>
                    </tr>
                    <tr style="width:100%;border: 1px solid;padding:0px;margin:0px">
                        <td style="width:20%;border: 1px solid;">26:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">27:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">28:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">29:<br/>-
                        </td>
                        <td style="width:20%;border: 1px solid;">30:<br/>-
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_mrporder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- AG Gases & Equipment Ltd -->
                <t t-if="o.company_id.report_format == 'ag_gases_report'">
                    <t t-call="pdf_report.ag_gases_report_mrporder_document" t-lang="o.user_id.lang"/>
                </t>
                <t t-else="">
                    <t t-call="mrp.report_mrporder" t-lang="o.user_id.lang"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
