<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ag_gases_saleorder_document">
        <t t-call="pdf_report.spantech_layout_standard">
            <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <br/>
            <br/>
            <div class="page sale-receipt">
                <div class="oe_structure"/>
                <table class="table table-sm o_main_table address_table" name="invoice_line_table">
                    <thead>
                        <tr class="bg-lightgrey">
                            <th class="text-left">
                                <span class="text-bold">Invoice to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">Ship to</span>
                            </th>
                            <th class="text-left">
                                <span class="text-bold">AG Reference No:</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="address_tbody">
                        <tr>
                            <td class="text-left">
                                <t t-if="o.partner_invoice_id">
                                    <h6 t-field="o.partner_invoice_id.name"/>
                                    <p>
                                        <span t-if="o.partner_invoice_id.street">
                                            <t t-out="o.partner_id.street"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.street2">
                                            <t t-out="o.partner_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.city">
                                            <t t-out="o.partner_id.city"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.zip">
                                            <t t-out="o.partner_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_invoice_id.country_id">
                                            <t t-out="o.partner_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="o.partner_shipping_id">
                                    <h6 t-field="o.partner_shipping_id.name"/>
                                    <p>
                                        <span t-if="o.partner_shipping_id.street">
                                            <t t-out="o.partner_shipping_id.street"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.street2">
                                            <t t-out="o.partner_shipping_id.street2"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.city">
                                            <t t-out="o.partner_shipping_id.city"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.zip">
                                            <t t-out="o.partner_shipping_id.zip"/>
                                        </span>
                                        <span t-if="o.partner_shipping_id.country_id">
                                            <t t-out="o.partner_shipping_id.country_id.name"/>
                                        </span>
                                    </p>
                                </t>
                                <t t-else="">
                                    <h6>-</h6>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="is_pro_forma">
                                    <span t-field="o.proforma_invoice_number"/>
                                </t>
                                <t t-elif="o.name">
                                    <span t-field="o.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Attn:</h6>
                                <t t-if="o.partner_contact_id">
                                    <span t-field="o.partner_contact_id.name"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Shipping:</h6>
                                <t t-if="o._name == 'sale.order'">
                                    <span t-field="o.shipping_info"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Date:</h6>
                                <!--<t t-if="o.commitment_date and env.context.get('confirmation', False) or o.commitment_date and is_order_conformation">-->
                                <!--<span t-field="o.commitment_date"-->
                                <!--t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>-->
                                <!--</t>-->
                                <t t-if="o.date_order and env.context.get('confirmation', False) or o.date_order and is_order_conformation">
                                    <span t-field="o.date_order"
                                          t-options='{"widget": "date"}'/>
                                </t>
                                <t t-elif="o.create_date">
                                    <span t-field="o.create_date"
                                          t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Customers Purchase Order Number:</h6>
                                <t t-if="o.client_order_ref">
                                    <span t-field="o.client_order_ref"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <!--<td class="text-left">-->
                            <!--<h6>Incoterms</h6>-->
                            <!--<t t-if="o.incoterm">-->
                            <!--<span t-field="o.incoterm"/>-->
                            <!--</t>-->
                            <!--<t t-else="">-->
                            <!--<span>-</span>-->
                            <!--</t>-->
                            <!--</td>-->
                            <td class="text-left">
                                <h6>Incoterm:</h6>
                                <t t-if="o.wo_incoterm">
                                    <span t-field="o.wo_incoterm"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Payment terms:</h6>
                                <t t-if="o.payment_term_id">
                                    <span t-field="o.payment_term_id"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-left">
                                <h6>Customers RFQ:</h6>
                                <t t-if="o.client_order_rfq">
                                    <span t-field="o.client_order_rfq"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <t t-if="env.context.get('confirmation', False) or is_order_conformation">
                                    <!--<h6>Due Date:</h6>-->
                                    <h6>Expected Delivery Date:</h6>
                                </t>
                                <t t-else="">
                                    <h6>Quote Expiry:</h6>
                                </t>
                                <t t-if="o.commitment_date and env.context.get('confirmation', False) or o.commitment_date and is_order_conformation">
                                    <span t-field="o.commitment_date"
                                          t-options='{"widget": "date"}'/>
                                </t>
                                <t t-elif="o.validity_date">
                                    <span t-field="o.validity_date"
                                          t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                            <td class="text-left">
                                <h6>Lead Time:</h6>
                                <t t-if="o.lead_time_sp">
                                    <span t-field="o.lead_time_sp"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <br/>
                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>

                <table class="table table-sm o_main_table product_table">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr class="bg-lightgrey">
                            <th name="th_index" class="text-center">
                                <span>No.</span>
                            </th>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_quantity" class="text-center">Quantity</th>
                            <th name="th_priceunit" class="text-center">Unit Price</th>
                            <th name="th_discount" t-if="display_discount" class="text-center"
                                groups="product.group_discount_per_so_line">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_taxes" class="text-center">Tax %</th>
                            <th name="th_subtotal" class="text-center">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <t t-set="index" t-value="1"/>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="doc.order_line" t-as="line">

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                               groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                               groups="account.group_show_line_subtotals_tax_included"/>

                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td class="text-center" name="product_index" style="vertical-align: middle;">
                                        <span t-out="index"/>
                                    </td>
                                    <td name="td_name">
                                        <span class="py-2" t-field="line.product_id.default_code"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <p class="bold_font">
                                            <t t-out="line.name"/>
                                            <t t-if="line.product_tmpl_notes">
                                                <br/>
                                                <t t-out="line.product_tmpl_notes"/>
                                            </t>
                                        </p>
                                        <span class="pb-1" t-field="line.product_id.x_studio_additional_description"
                                              t-options="{'widget': 'text'}"/>
                                        <br/>
                                        <t t-if="line.product_id.volume_sp">
                                            Volume[<span class="pb-1" t-field="line.product_id.volume_sp"
                                                         t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="line.product_id.pressure">
                                            Pressure[<span t-field="line.product_id.pressure"
                                                           t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="line.product_id.x_studio_shelf_life_months">
                                            Shelf Life Months[<span class="pb-1" t-field="line.product_id.x_studio_shelf_life_months"
                                                             t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="line.product_id.valve">
                                            Valve[<span t-field="line.product_id.valve"
                                                        t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="line.product_id.size">
                                            Size[<span t-field="line.product_id.size"
                                                       t-options="{'widget': 'text'}"/>]
                                        </t>
                                        <t t-if="line.product_id.sale_delay">
                                            Cusotomer Lead Time[
                                            <span t-field="line.product_id.sale_delay"
                                                  t-options="{'widget': 'text'}"/>
                                            days]
                                        </t>
                                    </td>
                                    <td name="td_quantity" class="text-center">
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <td name="td_priceunit" class="text-center">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" class="text-center"
                                        groups="product.group_discount_per_so_line">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <td name="td_taxes" class="text-center">
                                        <span t-out="', '.join(map(lambda x: str(x.amount)+'%', line.tax_id))"/>
                                    </td>
                                    <td name="td_subtotal" class="text-center o_price_total">
                                        <span t-field="line.price_subtotal"
                                              groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span t-field="line.price_total"
                                              groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td name="td_section_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td name="td_note_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                            </tr>

                            <t t-set="index" t-value="index + 1"/>

                            <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-right">
                                    <td name="td_section_subtotal" colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                                t-out="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row border-dark border mx-0" style="border-width: 2px !important;"
                         name="total">
                        <div class="col-8">
                            <t t-if="special_requirements">
                                <div class="special_details_box" name="special_details">
                                    <b>
                                        <u>Special Requirements</u>
                                    </b>
                                    <br/>
                                    <p t-field="o.special_requirements"/>
                                </div>
                            </t>
                            <p class="payment_details py-2">
                                <span class="font_bold">
                                    <u>Payment details</u>
                                </span>
                                <br/>
                                <t>
                                    <span>AG Gases &amp; Equipment LTD</span>
                                    <br/>
                                    <span>Sort Code: 204545</span>
                                    <br/>
                                    <span>Account No: 80345598</span>
                                    <br/>
                                    <span>IBAN: GB70BUKB20454580345598</span>
                                    <br/>
                                    <span>SWIFTBIC: BUKBGB22</span>
                                </t>
                            </p>
                        </div>
                        <div class="col-4">
                            <table class="table table-sm"
                                   style="page-break-inside: avoid;color: black;font-weight: bold;">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>
                                <!--                                <tr class="border-black o_subtotal">-->
                                <!--                                    <td>-->
                                <!--                                        <strong>-->
                                <!--                                            Excluding Tax-->
                                <!--                                        </strong>-->
                                <!--                                    </td>-->
                                <!--                                    <td class="text-right">-->
                                <!--                                        <span t-field="o.amount_untaxed"/>-->
                                <!--                                    </td>-->
                                <!--                                </tr>-->
                                <!--                                 <t t-set="tax_totals" t-value="o.tax_totals"/>-->
                                <!--&lt;!&ndash;                                    <t t-call="account.document_tax_totals"/>&ndash;&gt;-->
                                <!--&lt;!&ndash;                                <t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>&ndash;&gt;-->
                                <!--                                <t t-foreach="tax_totals['subtotals']" t-as="subtotal">-->
                                <!--                                    <t t-set="subtotal_to_show" t-value="subtotal['name']"/>-->
                                <!--                                    <t t-call="account.document_tax_totals"/>-->
                                <!--                                </t>-->
                                <!--                                <tr class="border-black o_total">-->
                                <!--                                    <td>-->
                                <!--                                        <strong>-->
                                <!--                                            Total-->
                                <!--                                        </strong>-->
                                <!--                                    </td>-->
                                <!--                                    <td class="text-right">-->
                                <!--                                        <span class="text-nowrap" t-field="o.amount_total"/>-->
                                <!--                                    </td>-->
                                <!--                                </tr>-->
                            </table>
                        </div>
                        <!--<div class="col-5 p-0 align-self-stretch d-flex">-->
                        <!--<table class="table table-sm border border-dark total_table">-->
                        <!--&lt;!&ndash; Tax totals &ndash;&gt;-->
                        <!--<t t-set="tax_totals" t-value="json.loads(doc.tax_totals_json)"/>-->
                        <!--<t t-call="account.document_tax_totals"/>-->
                        <!--</table>-->
                        <!--</div>-->
                    </div>
                </div>

                <br/>
                <!-- https://spantech.odoo.com/web#id=480&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
                <p t-if="o.is_IGM_customer" class="terms mt-1">
                    <span class="font_bold" style="font-size:20px">
                        <u>For IGM Declaration</u>
                    </span>
                    <br/>
                    <table name="IFM_Info" class="table table-sm o_main_table address_table" style="width:70%;">
                        <tbody>
                            <tr>
                                <td class="text-center" style="width:20%;">Consignee Name</td>
                                <td class="text-center">
                                    <span t-field="o.consignee_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Notify Party</td>
                                <td class="text-center">
                                    <span t-field="o.notify_party"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Value For Customs with Currency</td>
                                <td class="text-center">
                                    <span t-field="o.value_for_customs_with_currency"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Gross Weight</td>
                                <td class="text-center">
                                    <span t-field="o.manifested_gross_weight"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Manifested Packages</td>
                                <td class="text-center">
                                    <span t-field="o.manifested_packages"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width:20%;">Descrition of Goods</td>
                                <td class="text-center">
                                    <span t-field="o.description_of_goods"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </p>

                <br/>
                <br/>
                <p class="terms mt-1" style="page-break-after: always;">
                    <span class="font_bold">
                        <u>Terms and Conditions</u>
                    </span>
                    <br/>
                    <br/>
                    <span>This documentation has been produced wholly and exclusively with reference to AG Gases and
                        Equipment Ltd terms and conditions. A copy of which can be ordered from our sales team.
                    </span>
                    <br/>
                    <br/>
                    <span>It has come to our attention that somebody has contacted one of our customers claiming that
                        our bank details have changed.
                        Our bank details have NOT changed. All our bank details remain the same without any alterations.
                        Please report any bank change request to us via a confirmed secure method and do not respond to
                        bank change request.
                    </span>
                    <br/>
                    <br/>

                    <t t-if="env.context.get('confirmation', False) or is_order_conformation">
                        <span>
                            Please check this order acknowledgement carefully and if there is any difference from your
                            purchase order please contact us immediately!! any documentation that is required please
                            advise as soon as possible to prevent any delays
                        </span>
                    </t>
                    <t t-else="">
                        <span>AG Gases and Equipment Ltd Gas and Liquid Mixtures are manufactured strictly with
                            adherence to
                            our ISO9001:2015 approved quality management system.
                            <br/>
                            <br/>
                            All mixtures are produced gravimetrically. The balances used in the weighing process are
                            accurate to +/- 0.01g. This allows direct measurement of cylinder content during mixing and
                            eliminates errors associated with indirect manometric mixing techniques which are subject to
                            inaccuracies due to temperature and gas compressibility. The weights used to calibrate the
                            balances are traceable to NPL standards. High purity raw materials, supplied under a
                            Certificate
                            of Conformity, are used to ensure the final gravimetric filling accuracy.
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            Our standard preparation tolerance and certification accuracy (Certified Standard), are
                            given in the below table
                            <br/>
                            <table width="100%">
                                <tr>
                                    <td style="padding:10px">Concentration</td>
                                    <td style="padding:10px">Mixture Tolerance</td>
                                    <td style="padding:10px">Certified Accuracy</td>
                                </tr>
                                <tr>
                                    <td style="padding:10px">1-4.9 ppm</td>
                                    <td style="padding:10px">20%</td>
                                    <td style="padding:10px">1%</td>
                                </tr>
                                <tr>
                                    <td style="padding:10px">5-19.9 ppm</td>
                                    <td style="padding:10px">10%</td>
                                    <td style="padding:10px">1%</td>
                                </tr>
                                <tr>
                                    <td style="padding:10px">20-50 ppm</td>
                                    <td style="padding:10px">5%</td>
                                    <td style="padding:10px">1%</td>
                                </tr>
                                <tr>
                                    <td style="padding:10px">>50 ppm</td>
                                    <td style="padding:10px">2%</td>
                                    <td style="padding:10px">1%</td>
                                </tr>
                            </table>
                            <br/>
                            <br/>
                            All gas mix units are offered in mol% unless otherwise stated.
                            <br/>
                            <br/>
                            Any gas mixture supplied by AG Gases &amp; Equipment ltd must not be inhaled or ingested.
                            <br/>
                            <br/>
                            Air is defined as 20.9% Oxygen in Nitrogen.
                            <br/>
                            <br/>
                            SDS’s are available upon request.
                            <br/>
                            <br/>
                            The lead time for production is subject to availability of raw material stock at time of
                            placing
                            of an order.
                            <br/>
                            <br/>
                            AG Gases &amp; Equipment ltd reserves the right to amend this quotation because of manifest
                            error.
                            <br/>
                            <br/>
                            All gas products are classified as dangerous goods and will be transported accordingly.
                            <br/>
                            <br/>
                        </span>
                    </t>
                    <br/>
                </p>

                <div class="oe_structure"/>
                <p t-field="doc.note"/>

            </div>
        </t>

    </template>

</odoo>
