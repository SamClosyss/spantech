<?xml version="1.0"?>
<odoo>

    <record id="view_company_form_extended" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="phone" position="before">
                <field name="report_format"/>
            </field>
        </field>
    </record>

    <record id="view_menu_form_inherit" model="ir.ui.view">
        <field name="name">ir.ui.menu.form.inherit</field>
        <field name="model">ir.ui.menu</field>
        <field name="inherit_id" ref="base.edit_menu_access"/>
        <field name="arch" type="xml">
            <field name="sequence" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>
</odoo>
