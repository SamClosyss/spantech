<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_sale_extended_sp" model="ir.ui.view">
    <field name="name">mrp.production.inherited.form.sale.extended.sp</field>
    <field name="model">mrp.production</field>
    <field name="priority">64</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
<!--        <xpath expr="//label[@for='lot_producing_id']" position="before">-->
<!--            <field name="requirement" string="Customer Special Requirements"/>-->
<!--        </xpath>-->

        <!-- AG Gases Company Only -->
        <xpath expr="//page[@name='miscellaneous']" position="after">
            <page string="Certified Values" name="certified_values"
                  invisible="company_id != 7 and state in ['draft', 'cancel']">
                <field name="components_ids" mode="list" context="{'default_mo_id': id}">
                    <list editable="top">
                        <field name="component"/>
                        <field name="requested_value"/>
                        <field name="accuracy"/>
                        <field name="certified_value"/>
                    </list>
                </field>
            </page>

            <page string="Cylinder Values" name="cylinder_values"
                  invisible="company_id != 7 and state in ['draft', 'cancel']">
                <field name="cylinder_ids" mode="list" context="{'default_mo_id': id}">
                    <list editable="top">
                        <field name="name"/>
                    </list>
                </field>
            </page>
        </xpath>

        <xpath expr="//group[@name='group_extra_info']/field[@name='user_id']" position="after">
            <field name="valid_date" invisible="company_id != 7"/>
            <field name="logo_use" invisible="company_id != 7"/>
            <field name="logo" invisible="logo_use != 'custom'"/>
            <field name="all_in_gas_label_custom_logo" invisible="logo_use != 'all_in_gas'"/>
        </xpath>

        <xpath expr="//header" position="inside">

            <button name="print_bottle_label_pdf" type="object"
                    string="Bottle Label"
                    invisible="company_id != 7 or logo_use in ['cac_label', 'all_in_gas', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_certificate_pdf" type="object"
                    string="Certificate"
                    invisible="company_id != 7 or logo_use in ['cac_label', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_cac_label_pdf" type="object"
                    string="CAC Label"
                    invisible="company_id != 7 or logo_use in ['custom', 'AGGlabel', 'all_in_gas', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <field name="is_ag_backorder_of_cylinders" invisible="1"/>

            <button name="button_mark_done_all_backorders" type="object"
                    string="Mark As Done Backorders"
                    invisible="is_ag_backorder_of_cylinders != True or state != 'done'"/>

            <button name="print_qr_code" type="object"
                    string="Print QR"
                    invisible="company_id != 7 or logo_use in ['kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_cac_nrc_certificate" type="object"
                    string="CAC NRC Certificate"
                    invisible="company_id != 7 or logo_use in ['custom', 'AGGlabel', 'all_in_gas', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_cac_hpc_certificate" type="object"
                    string="CAC HPC Certificate"
                    invisible="company_id != 7 or logo_use in ['custom', 'AGGlabel', 'all_in_gas', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_all_in_gas" type="object"
                    string="All In Gas Label"
                    invisible="company_id != 7 or logo_use in ['custom', 'AGGlabel', 'cac_label', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_cac_box_label" type="object"
                    string="CAC Box Label"
                    invisible="company_id != 7 or logo_use in ['custom', 'AGGlabel', 'all_in_gas', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_kimessa_pdf" type="object"
                    string="Kimessa"
                    invisible="company_id != 7 or logo_use in ['cac_label', 'custom', 'all_in_gas', 'AGGlabel', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_all_in_gas_certificate_pdf" type="object"
                    string="All in Gas Certificate"
                    invisible="company_id != 7 or logo_use in ['cac_label', 'custom', 'AGGlabel', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

            <button name="print_cac_nkd_label" type="object"
                    string="CAC NKD Label"
                    invisible="company_id != 7 or logo_use in ['custom', 'AGGlabel', 'all_in_gas', 'kimessa_label', 'gas_tech', 'gas_alarm', 'encore_monitoring', 'CAC_gas_asia', 'CAC_gas_instrumentation', 'NZ_safety_blackwoods', 'mine_safety', 'skill_pro', 'alliance_safety']"/>

        </xpath>
    </field>
</record>

    </data>
</odoo>
