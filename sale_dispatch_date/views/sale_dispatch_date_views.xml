<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_dispatch_date_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.dispatch.date.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='effective_date']" position="after">
                <field name="dispatch_date" invisible="dispatch_date == False"/>
            </xpath>

            <xpath expr="//form" position="inside">
                <field name="delivery_done"/>
            </xpath>

            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_so_dispatch_date"
                        type="object"
                        string="Dispatched"
                        class="btn-primary"
                        invisible="delivery_done == False or dispatch_date != False"/>
            </xpath>
        </field>
    </record>
</odoo>
