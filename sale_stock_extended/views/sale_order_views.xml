<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- https://spantech.odoo.com/web?debug=1#id=311&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
    <record id="view_order_form_extended_spantech" model="ir.ui.view">
        <field name="name">sale.order.form.extended.spantech</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button name="create_po_without_confirm_order"
                        type="object"
                        string="Create PO"
                        groups="purchase.group_purchase_user"
                        invisible="purchase_order_count != 0 or state != 'draft'"/>

            </xpath>
            <!-- https://spantech.odoo.com/web#id=480&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
            <xpath expr="//notebook" position="inside">
                <field name="is_IGM_customer" invisible="1"/>
                <page string="IGM Information" name="IGM_information"
                      invisible="is_IGM_customer != True">
                    <group name="IGM_details">
                        <group>
                            <field name="consignee_name" required="is_IGM_customer == True"/>
                            <field name="notify_party" required="is_IGM_customer == True"/>
                            <field name="value_for_customs_with_currency" required="is_IGM_customer == True"/>
                            <field name="manifested_gross_weight" required="is_IGM_customer == True"/>
                            <field name="manifested_packages" required="is_IGM_customer == True"/>
                            <field name="description_of_goods" required="is_IGM_customer == True"/>
                        </group>
                        <group/>
                    </group>
                </page>
            </xpath>

            <!-- https://spantech.odoo.com/web?debug=1#id=482&menu_id=554&cids=7%2C4%2C3%2C2%2C1&action=806&model=project.task&view_type=form -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="partner_contact_id"
                       invisible="partner_id == False"
                       widget="selection"/>
                <field name="partner_responsible_rep" options="{'no_create':True}"/>
            </xpath>

            <!-- https://spantech.odoo.com/web?debug=1#id=391&menu_id=554&cids=7%2C4%2C3%2C2%2C1&action=806&model=project.task&view_type=form -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>


    <!-- https://spantech.odoo.com/web?debug=1#id=313&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
    <record id="view_order_quotation_tree_extended_sp" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.extended.sp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="sale_order_sent"
                       widget="badge"
                       optional="show"
                       decoration-danger="sale_order_sent == 'no'"
                       decoration-success="sale_order_sent == 'yes'"/>
            </xpath>
        </field>
    </record>

    <!-- https://spantech.odoo.com/web?debug=1#id=313&menu_id=554&cids=1%2C2%2C3%2C4&action=806&model=project.task&view_type=form -->
    <record id="view_order_tree_extended_sp" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.sp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="sale_order_sent"
                       widget="badge"
                       optional="show"
                       decoration-danger="sale_order_sent == 'no'"
                       decoration-success="sale_order_sent == 'yes'"/>
            </xpath>
        </field>
    </record>

</odoo>
