<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="merge_project_task_form_views_custom" model="ir.ui.view">
        <field name="name">project.task.form.view.custom</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
                <button name="action_merged_tasks" class="oe_stat_button" icon="fa-sliders" type="object" invisible="task_count == 0">
                    <field name="task_count" widget="statinfo" string="Merged Tasks" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
