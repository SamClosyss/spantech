<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.droggol.theme.common</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_website_create_new']" position="after">
                <button name="dr_open_theme_custom_modules" type="object" string="Theme Customizations" class="col-auto btn-info ms-2 text-nowrap" style="line-height: 0.5;" icon="fa-cog" noSaveDialog="true" invisible="not dr_has_custom_module"/>
                <field name="dr_has_custom_module" invisible="1"/>
            </xpath>
            <xpath expr="//block[@id='website_payment_block']" position="inside">
                <setting id="discount_sale_order_lines" title="Apply manual discounts on sales order lines or display discounts computed from pricelists (option to activate in the pricelist configuration).">
                    <field name="group_discount_per_so_line"/>
                    <div class="text-muted">
                        Grant discounts on sales order lines
                    </div>
                </setting>
            </xpath>
            <xpath expr="//block[@id='website_payment_block']" position="after">
                <block title="Progressive Web Apps (PWA)" id="pwa_settings">
                    <setting string="Enable Progressive Web Apps" help="Allows users to install your website as an application on mobile and desktop.">
                        <field name="dr_pwa_activated"/>
                        <div class="content-group" invisible="not dr_pwa_activated">
                            <div class="row mt-2" id="dr_pwa_name_setting">
                                <label string="Name" for="dr_pwa_name" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_name" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_short_name_setting">
                                <label string="Short Name" for="dr_pwa_short_name" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_short_name" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_background_color_setting">
                                <label string="Background Color" for="dr_pwa_background_color" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_background_color" widget="color" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_theme_color_setting">
                                <label string="Theme Color" for="dr_pwa_theme_color" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_theme_color" widget="color" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_icon_192_setting">
                                <label string="Icon (192x192)" for="dr_pwa_icon_192" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_icon_192" widget="image" class="w-25" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_icon_512_setting">
                                <label string="Icon (512x512)" for="dr_pwa_icon_512" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_icon_512" widget="image" class="w-25" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_start_url_setting">
                                <label string="Start URL" for="dr_pwa_start_url" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_start_url" required="dr_pwa_activated"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_shortcuts_setting">
                                <label string="App Shortcuts" for="dr_pwa_shortcuts" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_shortcuts" invisible="1"/>
                                <button name="dr_open_pwa_shortcuts" noSaveDialog="true" icon="fa-cogs me-1" type="object" string="Configure Shortcuts" class="btn-link"/>
                            </div>
                            <div class="row mt-2" id="dr_pwa_offline_page_setting">
                                <label string="Enable Offline Page" for="dr_pwa_offline_page" class="col-lg-3 o_light_label"/>
                                <field name="dr_pwa_offline_page"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
